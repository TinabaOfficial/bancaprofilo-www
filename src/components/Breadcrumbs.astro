---
import { getBreadcrumbs } from '../data/breadcrumbs';
import { sitePath } from '../config/site';

interface Props {
  slug: string;
  tone?: 'default' | 'light';
}

const { slug, tone = 'default' } = Astro.props;
const items = getBreadcrumbs(slug);
---

<nav class:list={['breadcrumbs', { 'breadcrumbs-light': tone === 'light' }]} aria-label="Percorso di navigazione">
  <ol>
    {items.map((item, index) => (
      <li>
        {index > 0 && <span class="separator" aria-hidden="true">›</span>}
        {index === items.length - 1 ? (
          <span aria-current="page">{item.label}</span>
        ) : (
          <a href={sitePath(item.href)}>{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    --breadcrumb-color: var(--ink-soft);
    --breadcrumb-current: var(--ink);
    --breadcrumb-hover: var(--accent-dark);
    margin-bottom: 2.5rem;
    color: var(--breadcrumb-color);
    font-size: .82rem;
    line-height: 1.5;
  }

  .breadcrumbs-light {
    --breadcrumb-color: #cbd7dc;
    --breadcrumb-current: var(--white);
    --breadcrumb-hover: var(--accent-light);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 .5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li { display: inline-flex; min-width: 0; align-items: baseline; gap: .5rem; }
  a, [aria-current='page'] {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-block: .5rem;
    overflow-wrap: anywhere;
  }
  a { color: inherit; text-underline-offset: .2em; }
  a:hover { color: var(--breadcrumb-hover); }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  [aria-current='page'] { color: var(--breadcrumb-current); font-weight: 700; }
  .separator { flex-shrink: 0; }
</style>
