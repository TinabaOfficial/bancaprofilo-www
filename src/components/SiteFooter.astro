---
import tinabaLogo from '../assets/brand/tinaba.svg';
import AssetImage from './AssetImage.astro';
import NavigationLink from './NavigationLink.astro';
import { footerGroups } from '../data/navigation';
import { siteConfig, sitePath } from '../config/site';

const appStores = [
  {
    label: 'Scarica Tinaba su Google Play',
    image: '/assets/stores/google-play.png',
    href: siteConfig.appStores.googlePlay,
  },
  {
    label: 'Scarica Tinaba su App Store',
    image: '/assets/stores/app-store.png',
    href: siteConfig.appStores.appStore,
  },
  {
    label: 'Scarica Tinaba su AppGallery',
    image: '/assets/stores/app-gallery.png',
    href: siteConfig.appStores.appGallery,
  },
];

const socialLinks = [
  { label: 'Instagram', href: siteConfig.social.instagram, image: '/assets/social/instagram.svg' },
  { label: 'Facebook', href: siteConfig.social.facebook, image: '/assets/social/facebook.svg' },
  { label: 'X', href: siteConfig.social.x, image: '/assets/social/x.svg' },
  { label: 'YouTube', href: siteConfig.social.youtube, image: '/assets/social/youtube.svg' },
  { label: 'LinkedIn', href: siteConfig.social.linkedin, image: '/assets/social/linkedin.svg' },
];
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-grid">
      {footerGroups.map((group) => (
        <nav class="footer-group" aria-label={group.label}>
          <h2>{group.label}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <NavigationLink link={link} showExternalIndicator={false} />
              </li>
            ))}
          </ul>
        </nav>
      ))}

    </div>

    <div class="footer-utilities">
      <a href={sitePath('/cookie/#preferenze')} data-cookie-preferences>
        Impostazioni cookie
      </a>
      <a
        class="reserved-area"
        href={siteConfig.destinations.homeBanking}
        target="_blank"
        rel="noopener noreferrer"
      >Area riservata <span aria-hidden="true">↗</span></a>
    </div>

    <div class="footer-bottom">
      <div class="company-details">
        <a class="brand" href={sitePath('/')} aria-label="Tinaba di Banca Profilo, home">
          <AssetImage src={tinabaLogo} alt="Tinaba di Banca Profilo" />
        </a>
        <p>
          Banca Profilo è il soggetto bancario di riferimento. Tinaba offre la piattaforma e il
          supporto tecnologico che rendono disponibili i servizi nell’App.
        </p>
        <p>
          Banca Profilo S.p.A. · P. IVA 09108700155 · Via Cerva 28, 20122 Milano (MI)<br />
          Tinaba S.p.A. · P. IVA 09158950965 · REA MI 2072562 · Via Cerva 28, 20122 Milano (MI)
        </p>
      </div>
      <div class="footer-engagement">
        <section class="stores" aria-labelledby="download-app-title">
          <h2 id="download-app-title">Scarica l’App</h2>
          <div class="store-list">
            {appStores.map((store) => (
              <a
                href={store.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={store.label}
              >
                <AssetImage
                  src={store.image}
                  alt={store.label}
                  width="300"
                  height="89"
                  loading="lazy"
                />
              </a>
            ))}
          </div>
        </section>
        <nav class="social" aria-label="Canali social Tinaba">
          {socialLinks.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
              <AssetImage src={social.image} alt="" aria-hidden="true" width="24" height="24" />
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-cookie-preferences]')
    .forEach((link) => {
      link.addEventListener('click', (event) => {
        const consent = (window as Window & {
          Cookiebot?: { renew?: () => void };
        }).Cookiebot;
        if (typeof consent?.renew !== 'function') return;
        event.preventDefault();
        consent.renew();
      });
    });
</script>

<style>@import "../styles/extracted/components_SiteFooter.css";</style>
