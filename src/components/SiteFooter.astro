---
import tinabaLogo from '../assets/brand/tinaba.svg';
---

<footer class="site-footer">
  <div><a class="brand" href="/" aria-label="Tinaba, home"><img src={tinabaLogo.src} alt="Tinaba" /></a><p>I soldi, come devono funzionare.</p></div>
  <nav class="footer-links" aria-label="Link istituzionali e di servizio"><a href="/assistenza/">Assistenza</a><a href="/chi-siamo/">Chi siamo</a><a href="/documenti/">Documenti legali</a><a href="/accessibilita/">Accessibilità</a><a href="/privacy/">Privacy</a><a href="/cookie/">Cookie</a></nav>
  <small>Contenuti e condizioni sono soggetti ad approvazione e aggiornamento.</small>
</footer>

<style>
  .site-footer { display: grid; grid-template-columns: minmax(12rem, 1fr) minmax(0, 2fr); gap: 2rem; width: 100%; margin: auto; padding: 4rem max(1.5rem, calc((100vw - 76rem) / 2 + 1.5rem)) 2rem; color: var(--white); background: var(--ink); }
  .site-footer .brand { display: inline-flex; width: 8rem; text-decoration: none; }
  .site-footer .brand img { display: block; width: 100%; height: auto; filter: brightness(0) invert(1); }
  .site-footer p { color: #c4d1d7; }
  .footer-links { display: flex; flex-wrap: wrap; align-content: start; gap: .75rem 1.5rem; }
  .footer-links a { color: white; text-decoration: none; }
  .footer-links a:hover { color: #ffb08a; }
  small { grid-column: 1 / -1; color: #afc0c9; }
  @media (max-width: 680px) { .site-footer { grid-template-columns: 1fr; padding-inline: 1rem; } small { grid-column: auto; } }
</style>
