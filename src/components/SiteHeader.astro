---
import tinabaLogo from '../assets/brand/tinaba.svg';
import AssetImage from './AssetImage.astro';
import { siteConfig, sitePath } from '../config/site';
import { solutions } from '../data/solutions';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
const hasCurrentSolution = solutions.some((solution) => isCurrent(solution.href));
---

<header class="site-header" data-site-header>
  <a class="brand" href={sitePath('/')} aria-label="Tinaba di Banca Profilo, home">
    <AssetImage src={tinabaLogo} alt="Tinaba di Banca Profilo" loading="eager" fetchpriority="high" />
  </a>
  <nav class="desktop-nav" aria-label="Navigazione principale">
    <details
      class="solutions-menu"
      class:has-current={hasCurrentSolution || isCurrent('/soluzioni/')}
    >
      <summary aria-controls="desktop-solutions-panel">Soluzioni</summary>
      <div class="solutions-panel" id="desktop-solutions-panel">
        <a
          class="solutions-overview"
          href={sitePath('/soluzioni/')}
          aria-current={isCurrent('/soluzioni/') ? 'page' : undefined}
        >Tutte le soluzioni <span aria-hidden="true">↗</span></a>
        <div class="solutions-links">
          {solutions.map((solution) => (
            <a
              href={sitePath(solution.href)}
              aria-current={isCurrent(solution.href) ? 'page' : undefined}
            >
              <strong>{solution.title}</strong>
              <span>{solution.text}</span>
            </a>
          ))}
        </div>
      </div>
    </details>
    <a href={sitePath('/piani/')} aria-current={isCurrent('/piani/') ? 'page' : undefined}>Piani</a>
    <a href={sitePath('/chi-siamo/')} aria-current={isCurrent('/chi-siamo/') ? 'page' : undefined}>Chi siamo</a>
    <a href={sitePath('/assistenza/')} aria-current={isCurrent('/assistenza/') ? 'page' : undefined}>Assistenza</a>
  </nav>
  <a class="access-link" href={siteConfig.destinations.homeBanking} target="_blank" rel="noopener noreferrer">Accedi <span aria-hidden="true">↗</span></a>
  <details class="mobile-menu">
    <summary aria-controls="mobile-navigation">Menu</summary>
    <nav id="mobile-navigation" aria-label="Navigazione mobile">
      <span class="menu-label">Esplora</span>
      <details
        class="mobile-solutions"
        class:has-current={hasCurrentSolution || isCurrent('/soluzioni/')}
      >
        <summary aria-controls="mobile-solutions-panel">Soluzioni</summary>
        <div class="mobile-solutions-panel" id="mobile-solutions-panel">
          <a
            class="solutions-overview"
            href={sitePath('/soluzioni/')}
            aria-current={isCurrent('/soluzioni/') ? 'page' : undefined}
          >Tutte le soluzioni</a>
          {solutions.map((solution) => (
            <a
              href={sitePath(solution.href)}
              aria-current={isCurrent(solution.href) ? 'page' : undefined}
            >
              {solution.title}
            </a>
          ))}
        </div>
      </details>
      <a href={sitePath('/piani/')} aria-current={isCurrent('/piani/') ? 'page' : undefined}>Piani</a>
      <a href={sitePath('/chi-siamo/')} aria-current={isCurrent('/chi-siamo/') ? 'page' : undefined}>Chi siamo</a>
      <a href={sitePath('/assistenza/')} aria-current={isCurrent('/assistenza/') ? 'page' : undefined}>Assistenza</a>
      <span class="menu-label">Accedi</span>
      <a href={siteConfig.destinations.homeBanking} target="_blank" rel="noopener noreferrer">Home Banking <span aria-hidden="true">↗</span></a>
    </nav>
  </details>
  <a class="button button-small" href={siteConfig.destinations.onboarding}>Apri il conto</a>
</header>

<style>@import "../styles/extracted/components_SiteHeader.css";</style>
