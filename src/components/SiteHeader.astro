---
import tinabaLogo from '../assets/brand/tinaba.svg';
---

<header class="site-header" data-site-header>
  <a class="brand" href="/" aria-label="Tinaba di Banca Profilo, home">
    <img src={tinabaLogo.src} alt="Tinaba di Banca Profilo" />
  </a>
  <nav class="desktop-nav" aria-label="Navigazione principale">
    <a href="/soluzioni/">Soluzioni</a>
    <a href="/piani/">Piani</a>
    <a href="/chi-siamo/">Chi siamo</a>
    <a href="/assistenza/">Assistenza</a>
  </nav>
  <details class="mobile-menu">
    <summary aria-label="Apri menu">Menu</summary>
    <nav aria-label="Navigazione mobile">
      <a href="/soluzioni/">Soluzioni</a>
      <a href="/piani/">Piani</a>
      <a href="/chi-siamo/">Chi siamo</a>
      <a href="/assistenza/">Assistenza</a>
    </nav>
  </details>
  <a class="button button-small" href="https://onboarding.bancaprofilo.it/#/">Apri il conto</a>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 9;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 76rem;
    margin: auto;
    padding: 1.25rem 1.5rem;
    background: var(--paper);
    transition: transform .25s ease;
  }
  .site-header.is-hidden { transform: translateY(-100%); }
  .brand { display: inline-flex; align-items: center; width: 9.5rem; flex: 0 0 9.5rem; text-decoration: none; }
  .brand img { display: block; width: 100%; height: auto; }
  nav { display: flex; gap: 1.5rem; color: var(--ink-soft); font-size: .93rem; }
  nav a { text-decoration: none; }
  nav a:hover { color: var(--accent-dark); }
  .desktop-nav { display: flex; }
  .mobile-menu { display: none !important; position: relative; color: var(--ink); }
  .mobile-menu summary { cursor: pointer; list-style: none; font-size: .9rem; font-weight: 750; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary::after { content: '＋'; margin-left: .35rem; color: var(--accent); }
  .mobile-menu[open] summary::after { content: '−'; }
  .mobile-menu nav { position: absolute; z-index: 10; top: 2rem; right: 0; display: grid; min-width: 10rem; gap: 0; padding: .5rem; border: 1px solid var(--line); border-radius: .8rem; background: var(--white); box-shadow: var(--shadow); }
  .mobile-menu nav a { padding: .65rem .75rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; background: var(--accent); color: white; padding: .85rem 1.25rem; text-decoration: none; font-weight: 700; transition: transform .2s ease, background .2s ease; }
  .button:hover { background: var(--accent-dark); transform: translateY(-2px); }
  .button-small { padding: .65rem 1rem; font-size: .9rem; white-space: nowrap; }
  @media (max-width: 680px) { .desktop-nav { display: none !important; } .mobile-menu { display: block !important; margin-left: auto; } .site-header { padding-inline: 1rem; gap: .8rem; } .brand { width: 8.3rem; flex-basis: 8.3rem; } .button-small { padding: .6rem .8rem; font-size: .8rem; } }
  @media (prefers-reduced-motion: reduce) { .site-header { transition: none; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menu = header?.querySelector<HTMLDetailsElement>('.mobile-menu');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (header && !reducedMotion) {
    const siteHeader = header;
    let lastScrollY = window.scrollY;
    let scrollFrame = 0;

    /** Show or hide the header according to the current scroll direction. */
    function updateHeader(): void {
      const currentScrollY = window.scrollY;

      if (currentScrollY <= 80 || currentScrollY < lastScrollY) {
        siteHeader.classList.remove('is-hidden');
      } else if (currentScrollY > lastScrollY && !menu?.open) {
        siteHeader.classList.add('is-hidden');
      }

      lastScrollY = currentScrollY;
      scrollFrame = 0;
    }

    window.addEventListener('scroll', () => {
      if (!scrollFrame) {
        scrollFrame = window.requestAnimationFrame(updateHeader);
      }
    }, { passive: true });
  }

  header?.addEventListener('focusin', () => {
    header.classList.remove('is-hidden');
  });
</script>
