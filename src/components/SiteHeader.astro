---
import tinabaLogo from '../assets/brand/tinaba.svg';
import AssetImage from './AssetImage.astro';
import NavigationGroups from './NavigationGroups.astro';
import NavigationFeature from './NavigationFeature.astro';
import NavigationLink from './NavigationLink.astro';
import { mainNavigation } from '../data/navigation';
import { siteConfig, sitePath } from '../config/site';

const currentSection = mainNavigation
  .flatMap((section) => section.activePaths.map((path) => ({ id: section.id, path })))
  .filter(({ path }) => Astro.url.pathname.startsWith(sitePath(path)))
  .sort((a, b) => b.path.length - a.path.length)[0]?.id;
---

<header class="site-header" data-site-header>
  <a class="brand" href={sitePath('/')} aria-label="Tinaba di Banca Profilo, home">
    <AssetImage
      src={tinabaLogo}
      alt="Tinaba di Banca Profilo"
      loading="eager"
      fetchpriority="high"
    />
  </a>
  <nav class="desktop-nav" aria-label="Navigazione principale">
    {mainNavigation.map((section) => (
      <details
        class:list={['navigation-menu', { 'has-current': currentSection === section.id }]}
        data-navigation-menu
      >
        <summary aria-controls={`desktop-${section.id}-panel`}>{section.label}</summary>
        <div class="navigation-panel" id={`desktop-${section.id}-panel`}>
          {section.overview && (
            <div class="navigation-overview"><NavigationLink link={section.overview} arrow /></div>
          )}
          <NavigationGroups groups={section.groups} columns={section.id === 'chi-siamo' ? 4 : 3} />
          {section.featured && <NavigationFeature feature={section.featured} />}
        </div>
      </details>
    ))}
  </nav>
  <details class="mobile-menu">
    <summary aria-controls="mobile-navigation">Menu</summary>
    <nav id="mobile-navigation" aria-label="Navigazione mobile">
      {mainNavigation.map((section) => (
        <details
          class:list={['mobile-section', { 'has-current': currentSection === section.id }]}
          data-navigation-menu
        >
          <summary aria-controls={`mobile-${section.id}-panel`}>{section.label}</summary>
          <div class="mobile-section-panel" id={`mobile-${section.id}-panel`}>
            {section.overview && (
              <div class="navigation-overview"><NavigationLink link={section.overview} arrow /></div>
            )}
            <NavigationGroups groups={section.groups} />
            {section.featured && <NavigationFeature feature={section.featured} />}
          </div>
        </details>
      ))}
    </nav>
  </details>
  <a class="button button-small" href={siteConfig.destinations.onboarding}>Apri il conto</a>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const menus = [...header.querySelectorAll<HTMLDetailsElement>('[data-navigation-menu]')];
    const mobileMenu = header.querySelector<HTMLDetailsElement>('.mobile-menu');

    for (const menu of menus) {
      menu.addEventListener('toggle', () => {
        if (!menu.open) return;
        for (const other of menus) {
          if (other !== menu) other.open = false;
        }
      });
    }

    header.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !(event.target instanceof Element)) return;
      const opened = event.target.closest<HTMLDetailsElement>('details[open]');
      if (!opened) return;
      opened.open = false;
      opened.querySelector<HTMLElement>(':scope > summary')?.focus();
      event.preventDefault();
    });

    const closeMenus = () => {
      for (const menu of menus) menu.open = false;
      if (mobileMenu) mobileMenu.open = false;
    };

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) closeMenus();
    });

    header.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) closeMenus();
    });

    window.matchMedia('(max-width: 960px)').addEventListener('change', closeMenus);
  }
</script>

<style>@import "../styles/extracted/components_SiteHeader.css";</style>
