---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const solutions = [
  ['Pagare', 'Carta, trasferimenti e pagamenti quotidiani in un unico posto.', '/carta/', '01'],
  ['Condividere', 'Gruppi e raccolte per dividere le spese senza complicazioni.', '/condivisione/', '02'],
  ['Risparmiare', 'Obiettivi e strumenti per dare una direzione ai tuoi soldi.', '/risparmio/', '03'],
  ['Investire', 'Informazioni chiare per scegliere con più consapevolezza.', '/investimenti/', '04'],
  ['Viaggiare', 'La tua App Tinaba anche quando sei lontano da casa.', '/pagamenti/alipay-plus/', '05'],
];

const plans = [
  { name: 'Start', text: 'La base per gestire il quotidiano.', image: '/assets/editorial/piano-start.png', href: '/piani/start/' },
  { name: 'Premium', text: 'Più vantaggi, quando ne vuoi di più.', image: '/assets/editorial/piano-premium.png', href: '/piani/premium/' },
  { name: 'Under18', text: 'Un primo passo verso l’autonomia.', image: '/assets/editorial/piano-under18.png', href: '/piani/under18/' },
];

const stories = [
  { title: 'Condividi senza rincorrere nessuno', text: 'Gruppi, raccolte e pagamenti pensati per fare insieme le cose semplici.', href: '/condivisione/', image: '/assets/editorial/app-community.png', alt: 'Schermata dell’app Tinaba dedicata alla condivisione' },
  { title: 'Tutto quello che ti serve, in un posto', text: 'Controlla il conto, la carta e i tuoi obiettivi con una vista chiara.', href: '/wallet/', image: '/assets/editorial/app-wallet-home.png', alt: 'Schermata della home dell’app Tinaba con conto, carta e risparmi' },
  { title: 'Parti leggero', text: 'Scopri i pagamenti e i vantaggi pensati per quando sei in viaggio.', href: '/pagamenti/alipay-plus/', image: '/assets/editorial/app-viaggi.png', alt: 'Schermata dell’app Tinaba con offerte e vantaggi' },
];

const highlights = [
  { label: 'Risparmiare', title: 'Conto Deposito: prima di scegliere, guarda tutti i dettagli.', href: '/risparmio/conto-deposito/', image: '/assets/editorial/news-conto-deposito.png', alt: 'Illustrazione Tinaba per il Conto Deposito' },
  { label: 'Investire', title: 'Roboadvisor: un modo guidato per orientarti.', href: '/investimenti/roboadvisor/', image: '/assets/editorial/news-roboadvisor.png', alt: 'Illustrazione Tinaba per il Roboadvisor' },
  { label: 'Community', title: 'Iniziative e opportunità da scoprire.', href: '/promozioni/', image: '/assets/editorial/news-scuola.png', alt: 'Illustrazione Tinaba per un’iniziativa della community' },
];
---

<BaseLayout title="Tinaba — I soldi, come devono funzionare." description="Conto, carta e strumenti digitali per gestire, condividere, risparmiare e orientare i tuoi soldi.">
  <SiteHeader />
  <main id="contenuto">
    <section class="hero section-wrap">
      <div class="hero-copy">
        <p class="eyebrow reveal" style="--reveal-delay: 80ms">Conto, carta e app</p>
        <h1 class="reveal" style="--reveal-delay: 160ms">I soldi,<br /><em>come devono funzionare.</em></h1>
        <p class="lead reveal" style="--reveal-delay: 240ms">Conto, carta e strumenti per gestire le spese di ogni giorno da una sola App.</p>
        <div class="actions reveal" style="--reveal-delay: 320ms"><a class="button" href="https://onboarding.bancaprofilo.it/#/">Apri il conto</a><a class="text-link" href="#soluzioni">Scopri cosa puoi fare <span aria-hidden="true">↗</span></a></div>
        <p class="hero-note reveal" style="--reveal-delay: 400ms">I servizi bancari sono offerti da Banca Profilo S.p.A. Tinaba abilita l’esperienza digitale.</p>
      </div>
      <div class="hero-visual reveal" style="--reveal-delay: 180ms">
        <div class="visual-orbit" aria-hidden="true"></div>
        <div class="hero-product">
          <img src="/assets/editorial/hero-app-wallet.png" alt="Schermata aggiornata dell’app Tinaba con conto, pagamenti e carta" class="hero-phone" />
        </div>
      </div>
    </section>

    <section id="soluzioni" class="section-wrap section-space"><div class="section-heading scroll-reveal"><div><p class="eyebrow">Cosa ti serve?</p><h2>Un conto che segue<br /><em>la tua vita.</em></h2></div><p class="section-copy">Dal primo caffè alla vacanza con gli amici: hai gli strumenti giusti, senza cambiare modo di pensare.</p></div><div class="solution-grid">{solutions.map(([title, text, href, index]) => <a class={`solution-card card-${index} scroll-reveal`} href={href}><span class="card-index">{index}</span><h3>{title}</h3><p>{text}</p><span class="arrow" aria-hidden="true">↗</span></a>)}</div></section>

    <section class="product-story section-wrap"><div class="story-intro"><p class="eyebrow">Dentro l’esperienza</p><h2>Non è solo un conto.<br /><em>È il tuo modo di usarlo.</em></h2><p>Un’app chiara, funzioni che riconosci e meno passaggi tra quello che vuoi fare e il risultato.</p><a class="text-link" href="/wallet/">Scopri il wallet <span aria-hidden="true">↗</span></a></div><div class="story-grid">{stories.map((story) => <a class="story-card" href={story.href}><div class="story-image"><img src={story.image} alt={story.alt} loading="lazy" /></div><div class="story-body"><h3>{story.title}</h3><p>{story.text}</p><span class="text-link">Approfondisci <span aria-hidden="true">↗</span></span></div></a>)}</div></section>

    <section id="piani" class="plans section-wrap"><div><p class="eyebrow">Scegli il tuo ritmo</p><h2>Il tuo conto.<br /><em>Le tue regole.</em></h2><p class="section-copy">Parti da ciò che ti serve oggi. Poi, se vuoi, aggiungi quello che ti aiuta a fare di più.</p><a class="text-link" href="/piani/">Confronta i piani <span aria-hidden="true">↗</span></a></div><div class="plan-stack">{plans.map((plan, index) => <a class:list={['plan-card', { 'plan-featured': index === 1 }]} href={plan.href}><img src={plan.image} alt="" loading="lazy" /><div><span>0{index + 1}</span><h3>{plan.name}</h3><p>{plan.text}</p></div><strong aria-hidden="true">↗</strong></a>)}</div></section>

    <section id="oltre" class="section-wrap section-space"><div class="section-heading"><div><p class="eyebrow">Oltre il prodotto</p><h2>Il valore non è<br /><em>solo nel conto.</em></h2></div><p class="section-copy">Idee, strumenti e iniziative per vivere il denaro con più consapevolezza.</p></div><div class="editorial-grid"><a class="editorial-card editorial-community" href="/community/"><span class="eyebrow">Community</span><h3>Il denaro funziona meglio quando crea connessioni.</h3><span class="text-link">Scopri la community <span aria-hidden="true">↗</span></span></a><a class="editorial-card editorial-help" href="/assistenza/"><span class="eyebrow">Sempre con te</span><h3>Hai una domanda? Partiamo da qui.</h3><span class="text-link">Vai all’assistenza <span aria-hidden="true">↗</span></span></a><a class="editorial-card editorial-docs" href="/documenti/"><span class="eyebrow">Trasparenza</span><h3>Le informazioni importanti, senza cercarle troppo.</h3><span class="text-link">Consulta i documenti <span aria-hidden="true">↗</span></span></a></div></section>

    <section id="novita" class="section-wrap section-space highlights"><div class="section-heading"><div><p class="eyebrow">In evidenza</p><h2>Le novità, <em>senza rumore.</em></h2></div><a class="text-link" href="/news/">Vedi tutte le novità <span aria-hidden="true">↗</span></a></div><div class="highlight-grid">{highlights.map((item) => <a class="highlight-card" href={item.href}><div class="highlight-image"><img src={item.image} alt={item.alt} loading="lazy" /></div><div class="highlight-body"><span class="eyebrow">{item.label}</span><h3>{item.title}</h3><span class="text-link">Approfondisci <span aria-hidden="true">↗</span></span></div></a>)}</div></section>

    <section class="closing"><div class="section-wrap closing-inner"><p class="eyebrow">Pronto a iniziare?</p><h2>Metti i tuoi soldi<br /><em>al posto giusto.</em></h2><a class="button button-light" href="https://onboarding.bancaprofilo.it/#/">Apri il conto</a></div></section>

    <aside class="trust-band section-wrap" aria-label="Informazioni istituzionali">
      <div class="trust-intro">
        <p class="eyebrow">Un rapporto chiaro</p>
        <h2>Una piattaforma digitale, una banca di riferimento.</h2>
      </div>
      <div class="trust-grid">
        <a href="/banca-profilo/" class="trust-item"><span>01</span><strong>Banca Profilo</strong><p>I servizi bancari sono offerti da Banca Profilo S.p.A.</p><b>Scopri il ruolo <i aria-hidden="true">↗</i></b></a>
        <a href="/chi-siamo/" class="trust-item"><span>02</span><strong>Tinaba</strong><p>La piattaforma tecnologica e operativa dell’esperienza digitale.</p><b>Chi siamo <i aria-hidden="true">↗</i></b></a>
        <a href="/documenti/" class="trust-item"><span>03</span><strong>Trasparenza</strong><p>Condizioni e documenti disponibili prima di scegliere.</p><b>Consulta i documenti <i aria-hidden="true">↗</i></b></a>
      </div>
    </aside>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .section-wrap { max-width: 76rem; margin-inline: auto; padding-inline: 1.5rem; }
  .hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 2rem; min-height: 44rem; padding-block: 4rem 5rem; }
  .eyebrow { margin: 0 0 1rem; color: var(--accent-dark); font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; } h1, h2 { letter-spacing: -.065em; line-height: .98; } h1 { max-width: 11ch; margin-bottom: 1.5rem; font-size: clamp(3.25rem, 5.8vw, 5.7rem); } h2 { margin-bottom: 1.5rem; font-size: clamp(2.8rem, 5vw, 5rem); } h3 { margin-bottom: .6rem; font-size: 1.45rem; letter-spacing: -.04em; } em { color: var(--accent); font-style: normal; }
  .lead { max-width: 31rem; color: var(--ink-soft); font-size: 1.18rem; } .hero-note { margin-top: 1.5rem; color: var(--ink-soft); font-size: .78rem; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; margin-top: 2rem; } .button { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; background: var(--accent); color: white; padding: .85rem 1.25rem; font-weight: 700; text-decoration: none; transition: transform .2s ease, background .2s ease, color .2s ease; } .button:hover { background: var(--accent-dark); transform: translateY(-2px); } .text-link { color: var(--ink); font-weight: 750; text-decoration: none; } .text-link:hover { color: var(--accent-dark); } .text-link span { color: var(--accent); }
  .hero-visual { position: relative; min-height: 40rem; isolation: isolate; } .visual-orbit { position: absolute; inset: 8% 0 2% 8%; overflow: hidden; border-radius: 52% 48% 1.8rem 1.8rem; background: linear-gradient(145deg, #f0ede4 0%, #e4dfd3 100%); transform: rotate(-7deg); } .visual-orbit::before { position: absolute; top: 7%; right: 3%; width: 62%; height: 60%; border-radius: 55% 45% 48% 52%; background: var(--ink); content: ''; opacity: .96; transform: rotate(12deg); } .visual-orbit::after { position: absolute; right: -12%; bottom: -18%; width: 68%; height: 68%; border-radius: 4rem 45% 4rem 50%; background: var(--accent); content: ''; opacity: .95; transform: rotate(-8deg); } .hero-product { position: absolute; z-index: 2; inset: 0 -2% -1rem 4%; display: flex; align-items: center; justify-content: center; min-height: 35rem; overflow: visible; background: transparent; } .hero-phone { position: relative; z-index: 2; display: block; width: min(35rem, 96%); filter: drop-shadow(0 1.7rem 1.2rem rgb(16 45 67 / .18)); transform: translateY(1rem); transition: transform .5s cubic-bezier(.22, 1, .36, 1); } .hero-visual:hover .hero-phone { transform: translateY(.25rem); }
  .trust-band { display: block; margin-block: 4rem 0; padding-block: 2.25rem 2.5rem; } .trust-intro { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; padding-bottom: 1.5rem; } .trust-intro .eyebrow { margin: 0; } .trust-intro h2 { max-width: 30ch; margin: 0; font-size: clamp(1.35rem, 2.2vw, 2rem); letter-spacing: -.04em; } .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; } .trust-item { display: flex; min-height: 8rem; flex-direction: column; padding: .9rem 1.5rem 0 0; border: 0; border-right: 1px solid var(--line); background: transparent; color: var(--ink); text-decoration: none; transition: color .2s ease, transform .2s ease; } .trust-item + .trust-item { padding-left: 1.5rem; } .trust-item:last-child { border-right: 0; padding-right: 0; } .trust-item:hover { color: var(--accent-dark); transform: translateY(-.15rem); } .trust-item > span { color: var(--accent); font-size: .7rem; font-weight: 800; letter-spacing: .08em; } .trust-item strong { margin-top: .8rem; color: var(--ink); font-size: .95rem; } .trust-item p { margin: .35rem 0 .75rem; color: var(--ink-soft); font-size: .82rem; } .trust-item b { margin-top: auto; color: var(--ink); font-size: .78rem; } .trust-item i { color: var(--accent); font-style: normal; }
  .section-space { padding-block: 8rem; } .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 3rem; } .section-copy { max-width: 28rem; color: var(--ink-soft); }
  .solution-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; } .solution-card { position: relative; min-height: 17rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-strong); color: var(--ink); text-decoration: none; transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease; } .solution-card:hover { border-color: var(--accent); transform: translateY(-.35rem); box-shadow: var(--shadow); } .solution-card p { max-width: 18rem; color: var(--ink-soft); } .card-index { color: var(--accent); font-size: .8rem; font-weight: 800; } .arrow { position: absolute; right: 1.5rem; bottom: 1.5rem; color: var(--accent); font-size: 1.4rem; }
  .product-story { display: grid; grid-template-columns: .75fr 1.25fr; gap: 5rem; align-items: start; padding-block: 6rem 8rem; } .story-intro { position: sticky; top: 2rem; } .story-intro > p:not(.eyebrow) { max-width: 25rem; color: var(--ink-soft); } .story-grid { display: grid; gap: 1rem; } .story-card { display: grid; grid-template-columns: 13rem 1fr; overflow: hidden; border-radius: var(--radius); background: var(--white); color: var(--ink); text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; } .story-card:hover { transform: translateY(-.2rem); box-shadow: var(--shadow); } .story-image { display: grid; min-height: 14rem; place-items: center; overflow: hidden; background: #eaf0f1; } .story-image img { width: 100%; height: 100%; object-fit: cover; } .story-body { display: flex; flex-direction: column; align-items: start; padding: 1.5rem; } .story-body p { color: var(--ink-soft); } .story-body .text-link { margin-top: auto; font-size: .9rem; }
  .plans { display: grid; grid-template-columns: .85fr 1.15fr; gap: 6rem; align-items: center; padding-block: 6rem; border-block: 1px solid var(--line); } .plan-stack { display: grid; gap: .75rem; } .plan-card { display: grid; grid-template-columns: 6rem 1fr auto; align-items: center; gap: 1rem; min-height: 7rem; padding: .75rem 1rem .75rem .75rem; border: 1px solid var(--line); border-radius: 1rem; background: var(--white); color: var(--ink); text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; } .plan-card:hover { transform: translateX(.3rem); box-shadow: var(--shadow); } .plan-card img { width: 6rem; height: 5rem; object-fit: cover; border-radius: .65rem; } .plan-card span { color: var(--accent); font-size: .8rem; font-weight: 800; } .plan-card h3 { margin: .2rem 0; } .plan-card p { margin: 0; color: var(--ink-soft); font-size: .9rem; } .plan-card > strong { color: var(--accent); font-size: 1.25rem; } .plan-featured { border-color: var(--accent); box-shadow: var(--shadow); transform: translateX(2rem); }
  .editorial-grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 1rem; } .editorial-card { display: flex; min-height: 18rem; flex-direction: column; align-items: start; justify-content: space-between; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-strong); color: var(--ink); text-decoration: none; transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease; } .editorial-card:hover { border-color: var(--accent); box-shadow: var(--shadow); transform: translateY(-.25rem); } .editorial-card h3 { max-width: 17rem; font-size: 1.8rem; } .editorial-card .eyebrow { color: var(--accent-dark); }
  .highlight-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; } .highlight-card { overflow: hidden; border-radius: var(--radius); background: var(--white); color: var(--ink); text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; } .highlight-card:hover { transform: translateY(-.25rem); box-shadow: var(--shadow); } .highlight-image { height: 10.5rem; overflow: hidden; background: #e9e7df; } .highlight-image img { width: 100%; height: 100%; object-fit: cover; } .highlight-body { display: flex; min-height: 13rem; flex-direction: column; align-items: start; padding: 1.4rem; } .highlight-body h3 { margin-bottom: 1.5rem; } .highlight-body .text-link { margin-top: auto; font-size: .9rem; }
  .closing { background: var(--accent); color: white; } .closing-inner { padding-block: 7rem; } .closing .eyebrow { color: white; } .closing h2 { font-size: clamp(3rem, 6vw, 6rem); } .closing em { color: white; } .button-light { background: var(--white); color: var(--ink); } .button-light:hover { background: #f0eee7; color: var(--ink); }
  @media (max-width: 1050px) { .solution-grid { grid-template-columns: repeat(3, 1fr); } .trust-intro { align-items: start; flex-direction: column; gap: .75rem; } .trust-intro h2 { max-width: 20ch; } .editorial-grid, .highlight-grid { grid-template-columns: 1fr 1fr; } .editorial-community { grid-row: span 2; } }
  @media (max-width: 850px) { .hero, .plans, .product-story { grid-template-columns: 1fr; } .hero { padding-block: 3rem 5rem; } .hero-visual { max-width: 35rem; width: 100%; margin-inline: auto; } .product-story { gap: 3rem; } .story-intro { position: static; } .solution-grid { grid-template-columns: repeat(2, 1fr); } .plans { gap: 3rem; } .section-heading { align-items: start; flex-direction: column; } }
  @media (max-width: 560px) { .section-wrap { padding-inline: 1rem; } .hero { min-height: auto; } .hero-visual { min-height: 29rem; } .hero-product { right: -5%; left: -5%; min-height: 26rem; } .hero-phone { width: 102%; } .section-space { padding-block: 5rem; } .solution-grid, .trust-grid, .editorial-grid, .highlight-grid { grid-template-columns: 1fr; } .trust-band { margin-top: 3rem; padding-block: 2rem; } .trust-intro { align-items: start; flex-direction: column; gap: .5rem; padding-bottom: 1rem; } .trust-intro h2 { font-size: 1.55rem; } .trust-item, .trust-item + .trust-item, .trust-item:last-child { min-height: auto; padding: .85rem 0 1rem; border-right: 0; border-bottom: 1px solid var(--line); } .trust-item:last-child { border-bottom: 0; padding-bottom: 0; } .trust-item strong { margin-top: .6rem; } .editorial-community { grid-row: auto; } .highlight-image { height: 8.5rem; } .story-card { grid-template-columns: 7rem 1fr; } .story-image { min-height: 12rem; } .story-body { padding: 1rem; } .story-body h3 { font-size: 1.15rem; } .plan-card { grid-template-columns: 4.5rem 1fr auto; } .plan-card img { width: 4.5rem; height: 4.25rem; } .plan-featured { transform: none; } }
</style>
