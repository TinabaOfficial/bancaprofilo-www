---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const solutions = [
  { number: '01', title: 'Conto e carta', text: 'Il punto di partenza per gestire il quotidiano dall’App: conto, carta e una vista chiara dei tuoi movimenti.', href: '/wallet/', label: 'Scopri conto e carta' },
  { number: '02', title: 'Pagamenti', text: 'Trasferimenti, pagamenti digitali e strumenti per usare il denaro dove ti serve, anche in viaggio.', href: '/pagamenti/', label: 'Scopri i pagamenti' },
  { number: '03', title: 'Condividere', text: 'Gruppi e raccolte per organizzare le spese con le persone che contano.', href: '/condivisione/', label: 'Scopri la condivisione' },
  { number: '04', title: 'Risparmiare', text: 'Obiettivi, Salvadanaio e Conto Deposito per dare una direzione ai tuoi risparmi.', href: '/risparmio/', label: 'Scopri il risparmio' },
  { number: '05', title: 'Investire', text: 'Strumenti e informazioni per orientarti tra le possibilità disponibili e decidere con consapevolezza.', href: '/investimenti/', label: 'Scopri gli investimenti' },
  { number: '06', title: 'Business', text: 'Strumenti digitali per attività e aziende che vogliono incassare e gestire i pagamenti.', href: '/business/', label: 'Scopri Tinaba Business' },
];
---

<BaseLayout title="Soluzioni | Tinaba" description="Scopri conto, carta, pagamenti, condivisione, risparmio, investimenti e soluzioni business disponibili nell’esperienza Tinaba di Banca Profilo.">
  <SiteHeader />
  <main id="contenuto">
    <section class="hero">
      <div class="wrap">
        <a class="back-link" href="/">← Torna alla home</a>
        <p class="eyebrow">Soluzioni</p>
        <h1>Il denaro, <em>come ti serve.</em></h1>
        <p class="intro">Dal conto ai pagamenti, dal risparmio agli investimenti: trovi gli strumenti disponibili nell’esperienza digitale Tinaba di Banca Profilo.</p>
      </div>
    </section>

    <section class="wrap overview" aria-labelledby="overview-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Scegli da dove iniziare</p>
          <h2 id="overview-title">Una soluzione<br /><em>per ogni esigenza.</em></h2>
        </div>
        <p>Ogni area ha una pagina dedicata con le informazioni utili, le funzionalità disponibili e, quando necessario, la documentazione da consultare prima di scegliere.</p>
      </div>
      <div class="solution-roadway">
        <svg class="solution-route solution-route--desktop" viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path class="route-road" fill="none" stroke="#e9500e" stroke-opacity=".09" stroke-linecap="round" stroke-linejoin="round" stroke-width="9" vector-effect="non-scaling-stroke" d="M 28 84 C 12 84 12 32 28 32 C 80 32 172 32 172 58 C 172 84 80 84 28 84 Z" />
          <path class="route-markings" fill="none" stroke="#a83900" stroke-opacity=".42" stroke-dasharray="3 3" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" vector-effect="non-scaling-stroke" d="M 28 84 C 12 84 12 32 28 32 C 80 32 172 32 172 58 C 172 84 80 84 28 84 Z" />
          <text class="route-currency" x="0" y="0" text-anchor="middle" dominant-baseline="central" alignment-baseline="central" fill="#e9500e" fill-opacity=".62" stroke="#fffdf8" stroke-opacity=".55" stroke-width=".12" paint-order="stroke" font-family="Arial, sans-serif" font-size="3" font-weight="700">
            €
            <animateMotion dur="24s" calcMode="paced" repeatCount="indefinite" rotate="0" path="M 28 84 C 12 84 12 32 28 32 C 80 32 172 32 172 58 C 172 84 80 84 28 84 Z" />
          </text>
        </svg>
        <svg class="solution-route solution-route--mobile" viewBox="0 0 42 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path class="route-road" fill="none" stroke="#e9500e" stroke-opacity=".09" stroke-linecap="round" stroke-width="9" vector-effect="non-scaling-stroke" d="M 21 95 C 13 95 7 75 7 50 C 7 25 13 5 21 5 C 29 5 35 25 35 50 C 35 75 29 95 21 95 Z" />
          <path class="route-markings" fill="none" stroke="#a83900" stroke-opacity=".42" stroke-dasharray="3 3" stroke-linecap="round" stroke-width="1.25" vector-effect="non-scaling-stroke" d="M 21 95 C 13 95 7 75 7 50 C 7 25 13 5 21 5 C 29 5 35 25 35 50 C 35 75 29 95 21 95 Z" />
          <text class="route-currency" x="0" y="0" text-anchor="middle" dominant-baseline="central" alignment-baseline="central" fill="#e9500e" fill-opacity=".62" stroke="#fffdf8" stroke-opacity=".55" stroke-width=".12" paint-order="stroke" font-family="Arial, sans-serif" font-size="3" font-weight="700">
            €
            <animateMotion dur="24s" calcMode="paced" repeatCount="indefinite" rotate="0" path="M 21 95 C 13 95 7 75 7 50 C 7 25 13 5 21 5 C 29 5 35 25 35 50 C 35 75 29 95 21 95 Z" />
          </text>
        </svg>
        <div class="solution-grid">
          {solutions.map((solution) => <a class="solution-card" href={solution.href}>
            <span>{solution.number}</span>
            <h3>{solution.title}</h3>
            <p>{solution.text}</p>
            <b>{solution.label} <i aria-hidden="true">↗</i></b>
          </a>)}
        </div>
      </div>
    </section>

    <section class="plans">
      <div class="wrap plans-inner">
        <div>
          <p class="eyebrow">Piani</p>
          <h2>Il conto parte da qui.<br /><em>Poi lo fai tuo.</em></h2>
        </div>
        <div>
          <p>Start, Premium e Under18 definiscono il modo in cui accedi ai servizi. Confronta caratteristiche, costi e condizioni prima di aderire.</p>
          <a class="button" href="/piani/">Confronta i piani <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <aside class="wrap institutional" aria-label="Ruoli istituzionali">
      <strong>Una distinzione chiara</strong>
      <p>I servizi bancari e finanziari sono offerti da Banca Profilo S.p.A. Tinaba abilita la piattaforma e l’esperienza digitale. Disponibilità, costi, rischi e condizioni sono indicati nelle pagine e nei documenti applicabili.</p>
      <a href="/banca-profilo/">Scopri il ruolo di Banca Profilo <span aria-hidden="true">↗</span></a>
    </aside>
  </main>
  <SiteFooter />
</BaseLayout>

<style>@import "../styles/extracted/pages_soluzioni.css";</style>
