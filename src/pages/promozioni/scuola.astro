---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AssetImage from '../../components/AssetImage.astro';
import { siteConfig } from '../../config/site';
---

<BaseLayout
  title="Promo Scuola | Tinaba"
  description="Ottieni 30€ e il 5% di Cashback sulle spese scolastiche aderendo alla Promo Scuola Tinaba."
>
  <SiteHeader />
  <main id="contenuto">
    <section class="promo-hero page-wrap">
      <div class="hero-copy">
        <a class="back-link" href="/promozioni/">← Torna alle promozioni</a>
        <p class="eyebrow">Promo Scuola</p>
        <h1>Le spese scolastiche sono inevitabili.<br /><em>Farle rendere è una scelta.</em></h1>
        <p class="lead">Ottieni 30€ + 5% di Cashback pagando le spese scolastiche dall’App Tinaba.</p>
        <div class="actions">
          <a class="button" href={siteConfig.destinations.promoScuola} target="_blank" rel="noreferrer">Scopri l’iniziativa <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={siteConfig.destinations.promoScuolaForm} target="_blank" rel="noreferrer">Aderisci ora <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-note">Verifica sempre requisiti, periodo di validità, condizioni e regolamento prima di aderire.</p>
      </div>
      <div class="hero-media">
        <AssetImage src="/assets/promotions/school/promo-scuola-hero-v2.png" alt="Illustrazione della Promo Scuola Tinaba con pagamento scolastico nell’app" loading="eager" fetchpriority="high" />
      </div>
    </section>

    <section class="intro-band">
      <div class="page-wrap intro-grid">
        <div>
          <p class="eyebrow">Paga come hai sempre fatto</p>
          <h2>Ottieni qualcosa<br /><em>in più.</em></h2>
        </div>
        <p>La Promo Scuola premia i pagamenti che già sostieni ogni anno. Nessuna spesa extra, nessun cambio di abitudini: puoi pagare mensa o rette che includono il servizio mensa con carta, PagoPA, bonifico o addebito diretto dall’App Tinaba.</p>
      </div>
    </section>

    <section class="page-wrap steps-section" aria-labelledby="steps-title">
      <div class="section-heading">
        <p class="eyebrow">Come funziona</p>
        <h2 id="steps-title">Tre passaggi per<br /><em>iniziare.</em></h2>
      </div>
      <div class="steps-grid">
        <article class="step-card"><AssetImage src="/assets/promotions/school/promo-scuola-aderisci.png" alt="Schermata di adesione alla Promo Scuola" loading="lazy" /><span>01</span><h3>Aderisci alla promozione</h3><p>Compila il form di adesione e inserisci le informazioni richieste.</p></article>
        <article class="step-card"><AssetImage src="/assets/promotions/school/promo-scuola-paga.png" alt="Pagamento delle spese scolastiche dall’App Tinaba" loading="lazy" /><span>02</span><h3>Paga le spese scolastiche</h3><p>Mensa o rette che includono il servizio mensa: paga con le modalità disponibili dall’App Tinaba.</p></article>
        <article class="step-card"><AssetImage src="/assets/promotions/school/promo-scuola-ricevi.png" alt="Ricezione del Cashback della Promo Scuola" loading="lazy" /><span>03</span><h3>Ricevi il Cashback</h3><p>Ottieni 30€ di Cashback dopo il primo pagamento idoneo, secondo i requisiti dell’iniziativa.</p></article>
      </div>
    </section>

    <section class="deposit-section page-wrap" aria-labelledby="deposit-title">
      <div class="deposit-media"><AssetImage src="/assets/promotions/school/promo-scuola-deposito.png" alt="Illustrazione del Conto Deposito a 12 mesi" loading="lazy" /></div>
      <div>
        <p class="eyebrow">Attiva il Conto Deposito</p>
        <h2 id="deposit-title">Ottieni di più<br /><em>dai tuoi risparmi.</em></h2>
        <p>Con il Conto Deposito di Banca Profilo, disponibile nell’App Tinaba, puoi attivare un vincolo a 12 mesi. Con il conto attivo, l’iniziativa prevede un Cashback aggiuntivo del 5% sui pagamenti scolastici previsti.</p>
        <p class="legal-note">Importo minimo, rendimento, requisiti e condizioni sono soggetti alla documentazione aggiornata e al regolamento della promozione.</p>
        <a class="text-link" href="/risparmio/conto-deposito/">Scopri il Conto Deposito <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="final-cta">
      <div class="page-wrap final-cta-inner">
        <div>
          <p class="eyebrow">Informazioni e regolamento</p>
          <h2>Prima di aderire,<br /><em>leggi tutto.</em></h2>
        </div>
        <div>
          <p>Per requisiti, modalità, validità e condizioni applicabili fa fede il regolamento ufficiale della promozione.</p>
          <a class="button button-light" href="/promozioni/">Promozioni e regolamenti <span aria-hidden="true">↗</span></a>
          <a class="external-link" href={siteConfig.destinations.promoScuola} target="_blank" rel="noreferrer">Vai alla pagina ufficiale <span aria-hidden="true">↗</span></a>
          <a class="text-link plans-link" href="/piani/">Confronta i piani Tinaba <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>@import "../../styles/extracted/pages_promozioni_scuola.css";</style>
