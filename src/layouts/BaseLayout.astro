---
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-700.css';
import '../styles/base.css';
import manrope400 from '@fontsource/manrope/files/manrope-latin-400-normal.woff2';
import manrope700 from '@fontsource/manrope/files/manrope-latin-700-normal.woff2';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  socialImage?: string;
  socialImageAlt?: string;
}

const { title, description, socialImage, socialImageAlt = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const publicOrigin = import.meta.env.BASE_URL === '/bancaprofilo-www/'
  ? siteConfig.previewUrl
  : siteConfig.canonicalUrl;
const socialImageUrl = socialImage
  ? new URL(`${import.meta.env.BASE_URL}${socialImage.replace(/^\//, '')}`, `${publicOrigin}/`)
  : undefined;
const consentEnabled = import.meta.env.PUBLIC_CONSENT_ENABLED === 'true';
const cookiebotId = import.meta.env.PUBLIC_COOKIEBOT_ID;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const canLoadConsent = consentEnabled && Boolean(cookiebotId) && Astro.url.hostname === siteConfig.productionHostname;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="preload" href={manrope400} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={manrope700} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.png`} type="image/png" sizes="32x32" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tinaba" />
    {socialImageUrl && <>
      <meta property="og:image" content={socialImageUrl} />
      <meta property="og:image:alt" content={socialImageAlt} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1734" />
      <meta property="og:image:height" content="907" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={socialImageUrl} />
      <meta name="twitter:image:alt" content={socialImageAlt} />
    </>}
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    {canLoadConsent && <script is:inline define:vars={{ cookiebotId, productionHostname: siteConfig.productionHostname, cookiebotScript: siteConfig.services.cookiebotScript }}>
      (() => {
        if (window.location.hostname !== productionHostname) return;
        const script = document.createElement('script');
        script.id = 'Cookiebot';
        script.src = cookiebotScript;
        script.async = false;
        script.dataset.cbid = cookiebotId;
        script.dataset.blockingmode = 'auto';
        document.head.appendChild(script);
      })();
    </script>}
    {canLoadConsent && gtmId && <>
      <script is:inline type="text/plain" data-cookieconsent="statistics">
        window.dataLayer = window.dataLayer || []; window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
      </script>
      <script type="text/plain" data-cookieconsent="statistics" src={`${siteConfig.services.googleTagManagerScript}?id=${gtmId}`}></script>
    </>}
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <slot />
  </body>
</html>

<style is:global>@import "../styles/extracted/layouts_BaseLayout.css";</style>
