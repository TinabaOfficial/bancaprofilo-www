---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/700.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tinaba" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #102d43;
    --ink-soft: #425667;
    --paper: #f7f5ef;
    --paper-strong: #efede5;
    --white: #fffdf8;
    --accent: #e9500e;
    --accent-dark: #a83900;
    --line: #d9d8d0;
    --radius: 1.25rem;
    --shadow: 0 1.5rem 4rem rgb(16 45 67 / 0.12);
    color: var(--ink);
    background: var(--paper);
    font-family: "Manrope", Arial, sans-serif;
    font-synthesis: none;
    line-height: 1.5;
  }

  ::selection { background: var(--accent); color: var(--white); }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; overflow-x: hidden; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .skip-link {
    position: absolute;
    top: -5rem;
    left: 1rem;
    z-index: 10;
    padding: .7rem 1rem;
    border-radius: .5rem;
    background: var(--ink);
    color: var(--white);
  }
  .skip-link:focus { top: 1rem; }
  @keyframes rise-in {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes float-gently {
    0%, 100% { transform: translateY(0) rotate(8deg); }
    50% { transform: translateY(-.45rem) rotate(8deg); }
  }
  .reveal { animation: rise-in .7s cubic-bezier(.22, 1, .36, 1) both; animation-delay: var(--reveal-delay, 0ms); }
  @supports (animation-timeline: view()) {
    .scroll-reveal { animation: rise-in linear both; animation-timeline: view(); animation-range: entry 8% cover 26%; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition-duration: .01ms !important; }
  }
</style>
