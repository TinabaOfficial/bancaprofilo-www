---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { EditorialPage } from '../data/pages';

interface Props {
  page: EditorialPage;
}
const { page } = Astro.props;
const visualAssets: Record<string, { src: string; alt: string }> = {
  carta: {
    src: '/assets/editorial/app-wallet-home.png',
    alt: 'Schermata della home dell’app Tinaba con conto, carta e risparmi',
  },
  wallet: {
    src: '/assets/editorial/app-wallet-home.png',
    alt: 'Schermata della home dell’app Tinaba con conto, carta e risparmi',
  },
  condivisione: {
    src: '/assets/editorial/app-community.png',
    alt: 'Schermata dell’app Tinaba dedicata alla condivisione',
  },
  risparmio: { src: '/assets/editorial/piano-start.png', alt: 'Illustrazione del piano Start Tinaba' },
  'risparmio/conto-deposito': {
    src: '/assets/reference/conto-deposito.png',
    alt: 'Anteprima del Conto Deposito nell’app Tinaba',
  },
  investimenti: {
    src: '/assets/editorial/app-titoli.png',
    alt: 'Schermata dell’app Tinaba con portafoglio e andamento degli investimenti',
  },
  'investimenti/roboadvisor': { src: '/assets/editorial/app-roboadvisor.png', alt: 'Schermata dell’app Tinaba con il portafoglio Roboadvisor' },
  'investimenti/conto-titoli': { src: '/assets/editorial/app-titoli.png', alt: 'Schermata dell’app Tinaba con portafoglio e andamento degli investimenti' },
  'investimenti/cripto': { src: '/assets/editorial/app-crypto.png', alt: 'Schermata dell’app Tinaba con il mercato delle criptovalute' },
  'pagamenti': { src: '/assets/editorial/app-viaggi.png', alt: 'Schermata dell’app Tinaba per pagamenti e vantaggi' },
  'pagamenti/mondiali': { src: '/assets/editorial/app-viaggi.png', alt: 'Schermata dell’app Tinaba per vantaggi e pagamenti in viaggio' },
  'pagamenti/alipay-plus': { src: '/assets/editorial/app-alipay.png', alt: 'Schermata dell’app Tinaba con Alipay+, mappa e QR Code per pagare in viaggio' },
  'pagamenti/trasferimenti': { src: '/assets/editorial/app-wallet-home.png', alt: 'Schermata della home dell’app Tinaba con conto e pagamenti' },
  'pagamenti/apple-pay': { src: '/assets/editorial/app-wallet-home.png', alt: 'Schermata della home dell’app Tinaba con carta e pagamenti digitali' },
  'pagamenti/google-pay': { src: '/assets/editorial/app-wallet-home.png', alt: 'Schermata della home dell’app Tinaba con carta e pagamenti digitali' },
  'condivisione/gruppi': { src: '/assets/editorial/app-community.png', alt: 'Schermata dell’app Tinaba con gruppi e spese condivise' },
  'condivisione/raccolte': { src: '/assets/editorial/app-community.png', alt: 'Schermata dell’app Tinaba con raccolte e denaro condiviso' },
  'risparmio/salvadanaio': { src: '/assets/editorial/piano-start.png', alt: 'Illustrazione Tinaba dedicata al risparmio' },
  'community': { src: '/assets/community/header-community.png', alt: 'Illustrazione di persone che condividono idee e pagamenti attraverso la community Tinaba' },
  'community/charity': { src: '/assets/community/charity-header.png', alt: 'Illustrazione di tre persone che si prendono cura di un cuore, simbolo delle iniziative Charity Tinaba' },
  'community/wishope': { src: '/assets/editorial/app-community.png', alt: 'Schermata dell’app Tinaba con iniziative di community' },
  'community/ambassador': { src: '/assets/editorial/app-community.png', alt: 'Schermata dell’app Tinaba dedicata alla community' },
  'chi-siamo/valori': { src: '/assets/reference/chi-siamo.png', alt: 'Illustrazione istituzionale Tinaba e Banca Profilo' },
  'chi-siamo/storia': { src: '/assets/reference/chi-siamo.png', alt: 'Illustrazione istituzionale Tinaba e Banca Profilo' },
  piani: { src: '/assets/editorial/piano-premium.png', alt: 'Illustrazione del piano Premium Tinaba' },
  'piani/start': { src: '/assets/editorial/piano-start.png', alt: 'Illustrazione del piano Start Tinaba' },
  'piani/premium': { src: '/assets/editorial/piano-premium.png', alt: 'Illustrazione del piano Premium Tinaba' },
  'piani/under18': { src: '/assets/editorial/piano-under18.png', alt: 'Illustrazione del piano Under18 Tinaba' },
  business: { src: '/assets/editorial/app-business.png', alt: 'Schermata dell’app Tinaba dedicata al profilo business' },
};
const visual = page.image ?? visualAssets[page.slug];
const productPagePrefixes = [
  'carta',
  'wallet',
  'pagamenti',
  'condivisione',
  'risparmio',
  'investimenti',
  'piani',
  'business',
];
const isProductPage = productPagePrefixes.some(
  (prefix) => page.slug === prefix || page.slug.startsWith(`${prefix}/`),
);
const assistanceTopics = [
  {
    title: 'App e conto',
    text: 'Accesso, apertura, ricariche, bonifici e operazioni quotidiane dall’App Tinaba.',
    href: '/wallet/',
    label: 'Scopri conto e App',
  },
  {
    title: 'Carta e pagamenti',
    text: 'Pagamenti online e nei negozi, carta virtuale, prelievi e dispositivi compatibili.',
    href: '/carta/',
    label: 'Scopri la carta',
  },
  {
    title: 'Risparmio e investimenti',
    text: 'Conto Deposito, Conto Titoli, cripto e le informazioni da leggere prima di operare.',
    href: '/investimenti/',
    label: 'Vai agli investimenti',
  },
  {
    title: 'Business',
    text: 'Incassi, e-commerce e strumenti per le attività che usano Tinaba Business.',
    href: '/business/',
    label: 'Scopri Business',
  },
  {
    title: 'Sicurezza',
    text: 'Indicazioni per riconoscere comunicazioni sospette e proteggere i tuoi dati.',
    href: '/assistenza/sicurezza/',
    label: 'Leggi i consigli',
  },
  {
    title: 'Documenti e reclami',
    text: 'Trasparenza bancaria, documenti legali, reclami e disconoscimento delle operazioni.',
    href: '/documenti/',
    label: 'Consulta i documenti',
  },
];
const assistanceFaqs = [
  {
    question: 'Posso emettere e ricevere bonifici?',
    answer: 'Sì. L’App Tinaba consente di emettere e ricevere bonifici nell’area SEPA. Costi e condizioni dipendono dal piano e dalla documentazione aggiornata.',
  },
  {
    question: 'Dove posso pagare con la carta?',
    answer: 'La carta Mastercard può essere utilizzata per gli acquisti nei negozi e online, nei limiti e secondo le condizioni del servizio.',
  },
  {
    question: 'Ho dimenticato il codice: cosa posso fare?',
    answer: 'Dalla schermata di accesso dell’App puoi selezionare la procedura per recuperare il codice e seguire le istruzioni ricevute sui recapiti associati.',
  },
  {
    question: 'Dove trovo le informazioni su costi e condizioni?',
    answer: 'Nella sezione Documenti trovi la trasparenza bancaria e la documentazione informativa da consultare prima di scegliere o utilizzare un prodotto.',
  },
];
const planChoices = [
  { name: 'Premium', label: 'Più vantaggi', description: 'Funzionalità social, vantaggi dedicati e commissioni ridotte.', href: '/piani/premium/', tone: 'featured' },
  { name: 'Start', label: 'Per ogni giorno', description: 'Gestisci il tuo denaro, tutto in una sola App.', href: '/piani/start/', tone: 'neutral' },
  { name: 'Under 18', label: 'Per iniziare', description: 'Un primo conto per iniziare a gestire il denaro con il supporto di un tutore.', href: '/piani/under18/', tone: 'light' },
];
const planDifferences = [
  { label: 'Esperienza quotidiana', premium: 'Più vantaggi e servizi riservati', start: 'Gli strumenti essenziali in App', under18: 'Strumenti per iniziare in autonomia' },
  { label: 'Risparmio e investimenti', premium: 'Secondo le condizioni del servizio', start: 'Secondo le condizioni del servizio', under18: 'Da verificare in base a età e autorizzazioni' },
  { label: 'Commissioni e limiti', premium: 'Condizioni dedicate al piano', start: 'Condizioni del piano Start', under18: 'Condizioni dedicate al profilo Under 18' },
  { label: 'Supporto', premium: 'Canali e servizi dedicati secondo disponibilità', start: 'Assistenza Tinaba', under18: 'Assistenza Tinaba e supporto del tutore' },
];
const communityPathways = [
  {
    eyebrow: 'Per organizzazioni e progetti',
    title: 'Conto e carta brandizzati',
    text: 'Costruisci un’esperienza riconoscibile per le persone della tua community, con strumenti e contenuti coerenti con il tuo progetto.',
    href: '/soluzioni/',
    label: 'Scopri le soluzioni',
    tone: 'dark',
  },
  {
    eyebrow: 'Per farti trovare',
    title: 'Visibilità in App',
    text: 'Rendi accessibili iniziative, vantaggi e riferimenti alla tua community in un unico spazio digitale.',
    href: '/soluzioni/',
    label: 'Scopri l’ecosistema',
    tone: 'light',
  },
  {
    eyebrow: 'Per premiare la partecipazione',
    title: 'Contenuti esclusivi',
    text: 'Dedica promozioni, contenuti e iniziative alla tua community, con una relazione più diretta.',
    href: '/news/',
    label: 'Vai alle iniziative',
    tone: 'orange',
  },
  {
    eyebrow: 'Per una causa che conta',
    title: 'Charity per i progetti',
    text: 'Crea una raccolta o un Negozio Solidale per sostenere un’iniziativa attraverso l’App Tinaba.',
    href: '/community/charity/',
    label: 'Scopri Charity',
    tone: 'light',
  },
];
const charitySteps = [
  {
    number: '01',
    title: 'Raccolte solidali',
    text: 'Dai forma a una raccolta per un ente, un progetto o una causa che ti sta a cuore.',
    image: '/assets/community/charity-collection.png',
    alt: 'Illustrazione di persone che partecipano a una raccolta attraverso lo smartphone',
  },
  {
    number: '02',
    title: 'Negozi solidali',
    text: 'Collega la tua missione a prodotti e iniziative che possono sostenerla.',
    image: '/assets/community/charity-store.png',
    alt: 'Anteprima di un negozio solidale nell’app Tinaba',
  },
  {
    number: '03',
    title: 'Una pagina da condividere',
    text: 'Raccogli le informazioni dell’iniziativa in uno spazio semplice da raccontare.',
    image: '/assets/community/charity-fundraising.png',
    alt: 'Anteprima di una raccolta fondi nell’app Tinaba',
  },
];
---

<BaseLayout title={`${page.title} | Tinaba`} description={page.intro}>
  <SiteHeader />
  <main id="contenuto">
    <section class:list={['page-hero', { 'page-hero-visual': visual }]}>
      <div class="page-wrap">
        <div class="hero-layout">
          <div>
            <a class="back-link reveal" href="/">← Torna alla home</a>
            <p class="eyebrow reveal" style="--reveal-delay: 100ms">{page.eyebrow}</p>
            <h1 class="reveal" style="--reveal-delay: 180ms">{page.title}</h1>
            <p class="intro reveal" style="--reveal-delay: 260ms">{page.intro}</p>
          </div>
          {visual && (
            <div
              class:list={['hero-visual reveal', { 'brand-logo-surface': page.slug === 'banca-profilo' }]}
              style="--reveal-delay: 220ms"
            >
              <img src={visual.src} alt={visual.alt} />
            </div>
          )}
        </div>
      </div>
    </section>
    {page.slug === 'piani' && <section class="plans-compare page-wrap" aria-labelledby="plans-compare-title">
      <div class="section-heading plans-heading">
        <div>
          <p class="eyebrow">In breve</p>
          <h2 id="plans-compare-title">Trova il piano<br /><em>che ti somiglia.</em></h2>
        </div>
        <p>Tre modi diversi di vivere il tuo conto: scegli quello che parte dalle tue esigenze di oggi.</p>
      </div>
      <div class="plan-choice-grid">
        {planChoices.map((plan) => <a class:list={['plan-choice', `plan-choice--${plan.tone}`]} href={plan.href}>
          <span class="plan-choice-label">{plan.label}</span>
          <h3>{plan.name}</h3>
          <p>{plan.description}</p>
          <span class="plan-choice-link">Scopri il piano <span aria-hidden="true">↗</span></span>
        </a>)}
      </div>
      <div class="comparison-wrap">
        <div class="comparison-intro">
          <p class="eyebrow">Principali differenze</p>
          <p>Per prezzi, commissioni, limiti, requisiti e disponibilità dei servizi fanno sempre fede la documentazione di Banca Profilo e le condizioni aggiornate nell’App.</p>
        </div>
        <div class="comparison-table-wrap">
          <table class="comparison-table">
            <caption class="visually-hidden">Confronto sintetico tra i piani Tinaba</caption>
            <thead><tr><th scope="col">Cosa cerchi</th><th scope="col">Premium</th><th scope="col">Start</th><th scope="col">Under 18</th></tr></thead>
            <tbody>{planDifferences.map((difference) => <tr><th scope="row">{difference.label}</th><td>{difference.premium}</td><td>{difference.start}</td><td>{difference.under18}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>}
    {page.slug === 'assistenza' && <>
      <section class="assistance-topics page-wrap" aria-labelledby="assistance-topics-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Da dove vuoi partire?</p>
            <h2 id="assistance-topics-title">Trova il percorso<br /><em>giusto per te.</em></h2>
          </div>
          <p>Abbiamo raccolto le aree di aiuto più richieste per accompagnarti dalla prima domanda al canale corretto.</p>
        </div>
        <div class="assistance-topic-grid">
          {assistanceTopics.map((topic) => (
            <article class="assistance-topic">
              <span class="topic-index" aria-hidden="true">{String(assistanceTopics.indexOf(topic) + 1).padStart(2, '0')}</span>
              <h3>{topic.title}</h3>
              <p>{topic.text}</p>
              <a class="topic-link" href={topic.href}>{topic.label} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>
      <section class="assistance-faq page-wrap" aria-labelledby="assistance-faq-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Le domande più frequenti</p>
            <h2 id="assistance-faq-title">Risposte chiare,<br /><em>senza giri.</em></h2>
          </div>
          <p>Una selezione delle domande presenti nel centro assistenza Tinaba. Per costi, requisiti e condizioni fa sempre fede la documentazione aggiornata.</p>
        </div>
        <div class="faq-list">
          {assistanceFaqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </>}
    {page.slug === 'wallet' && <section class="wallet-intro page-wrap scroll-reveal" aria-labelledby="wallet-intro-title">
      <div class="wallet-intro-heading">
        <p class="eyebrow">Il quotidiano, in ordine</p>
        <h2 id="wallet-intro-title">Tutto quello che ti serve,<br /><em>in un posto.</em></h2>
        <p>
          Dal saldo ai pagamenti, l’App Tinaba riunisce gli strumenti di Banca Profilo per gestire il
          denaro con una vista chiara.
        </p>
      </div>
      <div class="wallet-highlights">
        <article>
          <span class="highlight-number">01</span>
          <h3>Muovi il denaro</h3>
          <p>Trasferimenti istantanei, richieste di denaro e bonifici dall’App.</p>
        </article>
        <article>
          <span class="highlight-number">02</span>
          <h3>Paga quello che serve</h3>
          <p>Utenze, bollettini, MAV/RAV e PagoPA senza cambiare strumento.</p>
        </article>
        <article>
          <span class="highlight-number">03</span>
          <h3>Guarda tutto insieme</h3>
          <p>Conto, risparmi e investimenti disponibili in un’unica esperienza digitale.</p>
        </article>
      </div>
    </section>}
    {page.slug === 'community' && <section class="community-pathways" aria-labelledby="community-pathways-title">
      <div class="page-wrap">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Scegli il tuo percorso</p>
            <h2 id="community-pathways-title">Una community,<br /><em>molti modi per viverla.</em></h2>
          </div>
          <p>Che tu stia costruendo un progetto o cercando un modo concreto per partecipare, qui trovi il punto da cui partire.</p>
        </div>
        <div class="community-pathway-grid">
          {communityPathways.map((pathway) => <a class:list={['community-pathway', `community-pathway--${pathway.tone}`]} href={pathway.href}>
            <span class="pathway-eyebrow">{pathway.eyebrow}</span>
            <h3>{pathway.title}</h3>
            <p>{pathway.text}</p>
            <span class="pathway-link">{pathway.label} <span aria-hidden="true">↗</span></span>
          </a>)}
        </div>
      </div>
    </section>}
    {page.slug === 'community/charity' && <section class="charity-overview" aria-labelledby="charity-overview-title">
      <div class="page-wrap">
        <div class="charity-section-intro">
          <p class="eyebrow">Come partecipare</p>
          <h2 id="charity-overview-title">Tre modi per esserci.</h2>
        </div>
        <div class="charity-step-grid">
          {charitySteps.map((step) => <article class="charity-step">
            <div class="charity-step-art">
              <img src={step.image} alt={step.alt} loading="lazy" />
            </div>
            <span class="charity-step-number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>)}
        </div>
      </div>
    </section>}
    {page.slug === 'community/charity' && <section class="charity-initiatives page-wrap" aria-labelledby="charity-initiatives-title">
      <div>
        <p class="summary-label">Dalla community</p>
        <h2 id="charity-initiatives-title">Iniziative da<br /><em>scoprire.</em></h2>
      </div>
      <div>
        <p>{page.sections[1].body}</p>
      </div>
    </section>}
    {page.slug !== 'community/charity' && <section class="page-wrap content-grid">
      <div class="summary scroll-reveal">
        {page.image && (
          <div
            class:list={['page-image-frame', { 'brand-logo-surface': page.slug === 'banca-profilo' }]}
          >
            <img class="page-image" src={page.image.src} alt={page.image.alt} loading="lazy" />
          </div>
        )}
        <p class="summary-label">In breve</p>
        <p>{page.summary}</p>
        {page.cta && (
          <div class="summary-actions">
            <p class="summary-label">Prossimo passo</p>
            <a class="button" href={page.cta.href}>{page.cta.label}</a>
          </div>
        )}
        {page.links && (
          <nav class="document-links" aria-label="Documenti e contatti">
            {page.links.map((link) => (
              <a href={link.href}>
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        )}
        {isProductPage && <aside class="product-note" aria-label="Informazioni importanti">
          <strong>Prima di scegliere</strong>
          <p>
            Disponibilità, caratteristiche, costi, rischi e condizioni dipendono dal servizio e dalla
            documentazione aggiornata.
          </p>
          <a href="/documenti/">Vai ai documenti <span aria-hidden="true">↗</span></a>
        </aside>}
      </div>
      <div class="sections">
        {page.sections.map((section) => (
          <article class="scroll-reveal">
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </article>
        ))}
      </div>
    </section>}
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .page-wrap { max-width: 76rem; margin-inline: auto; padding-inline: 1.5rem; }
  .page-hero { padding: 3rem 0 6rem; background: var(--ink); color: var(--white); }
  .hero-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .65fr); align-items: center; gap: 4rem; }
  .back-link { display: inline-block; margin-bottom: 5rem; color: #c4d1d7; text-decoration: none; }
  .back-link:hover { color: white; }
  .eyebrow { margin: 0 0 1rem; color: #ffb08a; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  h1, h2 { letter-spacing: -.06em; line-height: 1; } h1 { max-width: 12ch; margin: 0 0 1.5rem; font-size: clamp(3.25rem, 8vw, 7rem); } h2 { margin-bottom: .75rem; font-size: clamp(1.8rem, 3vw, 2.7rem); }
  .intro { max-width: 38rem; margin: 0; color: #d7e0e4; font-size: 1.25rem; }
  .hero-visual { display: grid; min-height: 20rem; place-items: center; overflow: hidden; border-radius: 1.25rem; background: #e9e7df; }
  .hero-visual img { display: block; width: 100%; height: 100%; max-height: 25rem; object-fit: contain; }
  .brand-logo-surface { background: #294158; }
  .hero-visual.brand-logo-surface { padding: clamp(2rem, 6vw, 4rem); box-sizing: border-box; }
  .page-hero:not(.page-hero-visual) .hero-layout { display: block; }
  .wallet-intro { display: grid; grid-template-columns: .8fr 1.2fr; gap: 5rem; align-items: end; padding-block: 6rem 5rem; }
  .wallet-intro-heading h2 { margin: 0 0 1.25rem; color: var(--ink); font-size: clamp(2.7rem, 5vw, 4.8rem); letter-spacing: -.065em; line-height: .98; }
  .wallet-intro-heading em { color: var(--accent); font-style: normal; }
  .wallet-intro-heading > p:last-child { max-width: 28rem; margin: 0; color: var(--ink-soft); font-size: 1.08rem; }
  .wallet-highlights { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  .wallet-highlights article { min-height: 13rem; padding: 1.25rem; border-top: 2px solid var(--accent); background: var(--white); }
  .wallet-highlights h3 { margin: 2.5rem 0 .6rem; font-size: 1.25rem; }
  .wallet-highlights p { margin: 0; color: var(--ink-soft); font-size: .95rem; }
  .highlight-number { color: var(--accent); font-size: .75rem; font-weight: 800; letter-spacing: .12em; }
  .content-grid { display: grid; grid-template-columns: .75fr 1.25fr; gap: 6rem; padding-block: 6rem; }
  .summary { color: var(--ink-soft); font-size: 1.15rem; } .summary p { margin-top: 0; }
  .summary-label { margin-bottom: .55rem !important; color: var(--accent-dark); font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .summary-actions { margin-top: 2rem; }
  .summary-actions .summary-label { margin-bottom: .75rem !important; }
  .page-image-frame { width: min(100%, 21rem); margin: 0 0 2rem; }
  .page-image-frame.brand-logo-surface { padding: 1.5rem; border-radius: .75rem; }
  .page-image { display: block; width: 100%; max-height: 24rem; object-fit: contain; object-position: left bottom; }
