---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AssetImage from '../components/AssetImage.astro';
import type { EditorialPage } from '../data/pages';
import { visualAssets } from '../data/editorial/visual-assets';
import { productNotices, productPagePrefixes } from '../data/editorial/product-content';
import { alipayPlusCountries, assistanceFaqs, assistanceTopics, charitySteps, communityPathways, planChoices, planDifferences, pressItems } from '../data/editorial/sections';

interface Props {
  page: EditorialPage;
}
const { page } = Astro.props;
const visual = page.image ?? visualAssets[page.slug];
const isProductPage = productPagePrefixes.some(
  (prefix) => page.slug === prefix || page.slug.startsWith(`${prefix}/`),
);
const productNotice = productNotices[page.slug] ?? (isProductPage ? {
  title: 'Informazioni sul servizio',
  body: 'Disponibilità, caratteristiche, costi e condizioni sono quelli indicati nella documentazione aggiornata di Banca Profilo.',
} : undefined);
---

<BaseLayout title={`${page.title} | Tinaba`} description={page.intro}>
  <SiteHeader />
  <main id="contenuto">
    <section class:list={['page-hero', { 'page-hero-visual': visual, 'page-hero-plans': page.slug === 'piani' }]}>
      <div class="page-wrap">
        <div class="hero-layout">
          <div>
            <a class="back-link reveal" href="/">← Torna alla home</a>
            <p class="eyebrow reveal" style="--reveal-delay: 100ms">{page.eyebrow}</p>
            <h1 class="reveal" style="--reveal-delay: 180ms">{page.title}</h1>
            <p class="intro reveal" style="--reveal-delay: 260ms">{page.intro}</p>
          </div>
          {visual && (
            <div
              class:list={['hero-visual reveal', { 'brand-logo-surface': page.slug === 'banca-profilo', 'plans-hero-visual': page.slug === 'piani' }]}
              style="--reveal-delay: 220ms"
            >
              <AssetImage src={visual.src} alt={visual.alt} />
            </div>
          )}
        </div>
      </div>
    </section>
    {page.slug === 'piani' && <aside id="plans-promotion" class="plans-promotion page-wrap" aria-labelledby="plans-promotion-title">
      <div class="plans-promotion-mark" aria-hidden="true">In evidenza</div>
      <div class="plans-promotion-copy">
        <p class="eyebrow">Promozione attiva</p>
        <h2 id="plans-promotion-title">Prima di scegliere, guarda le opportunità attive.</h2>
        <p>Scopri la Promo Scuola: 30€ + 5% di Cashback sulle spese scolastiche, secondo requisiti e regolamento.</p>
      </div>
      <a class="text-link" href="/promozioni/scuola/">Scopri la promozione <span aria-hidden="true">↗</span></a>
    </aside>}
    {page.slug === 'piani' && <section class="plans-compare page-wrap" aria-labelledby="plans-compare-title">
      <div class="section-heading plans-heading">
        <div>
          <p class="eyebrow">In breve</p>
          <h2 id="plans-compare-title">Trova il piano<br /><em>che ti somiglia.</em></h2>
        </div>
        <p>Tre modi diversi di vivere il tuo conto: scegli quello che parte dalle tue esigenze di oggi.</p>
      </div>
      <div class="plan-choice-grid">
        {planChoices.map((plan) => <a class:list={['plan-choice', `plan-choice--${plan.tone}`]} href={plan.href}>
          <span class="plan-choice-label">{plan.label}</span>
          <h3>{plan.name}</h3>
          <p class="plan-choice-audience">{plan.audience}</p>
          <strong class="plan-choice-price">{plan.price}</strong>
          <p>{plan.description}</p>
          <ul class="plan-choice-features">
            {plan.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <span class="plan-choice-link">Scopri il piano <span aria-hidden="true">↗</span></span>
        </a>)}
      </div>
      <div class="comparison-wrap">
        <div class="comparison-intro">
          <p class="eyebrow">Principali differenze</p>
          <p>Dal conto alle opportunità di risparmio: qui trovi le differenze più importanti per orientarti tra i tre piani.</p>
        </div>
        <div class="comparison-table-wrap">
          <table class="comparison-table">
            <caption class="visually-hidden">Confronto sintetico tra i piani Tinaba</caption>
            <thead><tr><th scope="col">Cosa cerchi</th><th scope="col">Premium</th><th scope="col">Start</th><th scope="col">Under 18</th></tr></thead>
            <tbody>{planDifferences.map((difference, index) => <>
              {(index === 0 || planDifferences[index - 1].group !== difference.group) && <tr class="comparison-group"><th colspan="4">{difference.group}</th></tr>}
              <tr><th scope="row">{difference.label}</th><td>{difference.premium}</td><td>{difference.start}</td><td>{difference.under18}</td></tr>
            </>)}</tbody>
          </table>
          <p class="comparison-footnote">* Valori, disponibilità e condizioni sono quelli della documentazione aggiornata di Banca Profilo e dell’App Tinaba.</p>
        </div>
      </div>
      <aside class="plans-next-step" aria-label="Informazioni prima della scelta">
        <div>
          <p class="eyebrow">Prima di scegliere</p>
          <p>Prezzi, commissioni, limiti, requisiti e disponibilità dei servizi fanno sempre fede nella documentazione aggiornata di Banca Profilo e nell’App Tinaba.</p>
        </div>
        <div class="plans-next-step-links">
          <a class="button" href="https://onboarding.bancaprofilo.it">Apri il conto</a>
          <a class="text-link" href="/documenti/">Consulta i documenti <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </section>}
    {page.slug === 'pagamenti/alipay-plus' && <section class="alipay-plus-overview page-wrap" aria-labelledby="alipay-plus-overview-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Dove puoi usarlo</p>
          <h2 id="alipay-plus-overview-title">Un viaggio, più<br /><em>possibilità.</em></h2>
        </div>
        <p>La pagina originale presenta una rete internazionale in espansione, con pagamenti presso gli esercenti che espongono il logo Alipay+ e, in Giappone, presso gli esercenti PayPay aderenti.</p>
      </div>
      <div class="alipay-plus-map-layout">
        <figure class="alipay-plus-map">
          <AssetImage src="/assets/editorial/alipay-map.png" alt="Mappa illustrativa dei paesi in cui il servizio Alipay+ è indicato come disponibile" loading="lazy" />
          <figcaption>Rappresentazione informativa: disponibilità, copertura e modalità possono cambiare.</figcaption>
        </figure>
        <div class="alipay-plus-how">
          <p class="summary-label">Come funziona</p>
          <ol>
            <li><strong>Apri l’App Tinaba</strong><span>Accedi al servizio Alipay+ prima di effettuare il pagamento.</span></li>
            <li><strong>Cerca il logo</strong><span>Verifica che l’esercente esponga Alipay+ o, in Giappone, PayPay.</span></li>
            <li><strong>Inquadra il QR code</strong><span>Segui i passaggi mostrati in App e controlla il riepilogo prima di confermare.</span></li>
          </ol>
        </div>
      </div>
      <div class="alipay-plus-countries">
        <div>
          <p class="summary-label">Elenco indicativo</p>
          <h3>Paesi presenti nella pagina originale</h3>
          <p>Questa lista è orientativa e non sostituisce il dettaglio aggiornato del servizio.</p>
        </div>
        <ul aria-label="Paesi indicati per Alipay+">
          {alipayPlusCountries.map((country) => <li>{country}</li>)}
        </ul>
      </div>
      <aside class="alipay-plus-note">
        <div>
          <strong>Prima di partire</strong>
          <p>Controlla il dettaglio dei paesi aderenti, i negozi e le modalità operative aggiornate. I riferimenti della pagina originale possono essere modificati dal servizio.</p>
        </div>
        <a class="button" href="/documents/Dettaglio-paesi-Alipay.pdf">Scarica il dettaglio dei paesi <span aria-hidden="true">↗</span></a>
      </aside>
    </section>}
    {page.slug === 'assistenza' && <>
      <section class="assistance-topics page-wrap" aria-labelledby="assistance-topics-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Da dove vuoi partire?</p>
            <h2 id="assistance-topics-title">Trova il percorso<br /><em>giusto per te.</em></h2>
          </div>
          <p>Abbiamo raccolto le aree di aiuto più richieste per accompagnarti dalla prima domanda al canale corretto.</p>
        </div>
        <div class="assistance-topic-grid">
          {assistanceTopics.map((topic) => (
            <article class="assistance-topic">
              <span class="topic-index" aria-hidden="true">{String(assistanceTopics.indexOf(topic) + 1).padStart(2, '0')}</span>
              <h3>{topic.title}</h3>
              <p>{topic.text}</p>
              <a class="topic-link" href={topic.href}>{topic.label} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </section>
      <section class="assistance-faq page-wrap" aria-labelledby="assistance-faq-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Le domande più frequenti</p>
            <h2 id="assistance-faq-title">Risposte chiare,<br /><em>senza giri.</em></h2>
          </div>
          <p>Una selezione delle domande presenti nel centro assistenza Tinaba. Per costi, requisiti e condizioni fa sempre fede la documentazione aggiornata.</p>
        </div>
        <div class="faq-list">
          {assistanceFaqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </>}
    {page.slug === 'wallet' && <section class="wallet-intro page-wrap scroll-reveal" aria-labelledby="wallet-intro-title">
      <div class="wallet-intro-heading">
        <p class="eyebrow">Il quotidiano, in ordine</p>
        <h2 id="wallet-intro-title">Tutto quello che ti serve,<br /><em>in un posto.</em></h2>
        <p>
          Dal saldo ai pagamenti, l’App Tinaba riunisce gli strumenti di Banca Profilo per gestire il
          denaro con una vista chiara.
        </p>
      </div>
      <div class="wallet-highlights">
        <article>
          <span class="highlight-number">01</span>
          <h3>Muovi il denaro</h3>
          <p>Trasferimenti istantanei, richieste di denaro e bonifici dall’App.</p>
        </article>
        <article>
          <span class="highlight-number">02</span>
          <h3>Paga quello che serve</h3>
          <p>Utenze, bollettini, MAV/RAV e PagoPA senza cambiare strumento.</p>
        </article>
        <article>
          <span class="highlight-number">03</span>
          <h3>Guarda tutto insieme</h3>
          <p>Conto, risparmi e investimenti disponibili in un’unica esperienza digitale.</p>
        </article>
      </div>
    </section>}
    {page.slug === 'community' && <section class="community-pathways" aria-labelledby="community-pathways-title">
      <div class="page-wrap">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Scegli il tuo percorso</p>
            <h2 id="community-pathways-title">Una community,<br /><em>molti modi per viverla.</em></h2>
          </div>
          <p>Che tu stia costruendo un progetto o cercando un modo concreto per partecipare, qui trovi il punto da cui partire.</p>
        </div>
        <div class="community-pathway-grid">
          {communityPathways.map((pathway) => <a class:list={['community-pathway', `community-pathway--${pathway.tone}`]} href={pathway.href}>
            <span class="pathway-eyebrow">{pathway.eyebrow}</span>
            <h3>{pathway.title}</h3>
            <p>{pathway.text}</p>
            <span class="pathway-link">{pathway.label} <span aria-hidden="true">↗</span></span>
          </a>)}
        </div>
      </div>
    </section>}
    {page.slug === 'community/charity' && <section class="charity-overview" aria-labelledby="charity-overview-title">
      <div class="page-wrap">
        <div class="charity-section-intro">
          <p class="eyebrow">Come partecipare</p>
          <h2 id="charity-overview-title">Tre modi per esserci.</h2>
        </div>
        <div class="charity-step-grid">
          {charitySteps.map((step) => <article class="charity-step">
            <div class="charity-step-art">
              <AssetImage src={step.image} alt={step.alt} loading="lazy" />
            </div>
            <span class="charity-step-number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>)}
        </div>
      </div>
    </section>}
    {page.slug === 'community/charity' && <section class="charity-initiatives page-wrap" aria-labelledby="charity-initiatives-title">
      <div>
        <p class="summary-label">Dalla community</p>
        <h2 id="charity-initiatives-title">Iniziative da<br /><em>scoprire.</em></h2>
      </div>
      <div>
        <p>{page.sections[1].body}</p>
      </div>
    </section>}
    {page.slug === 'community/charity' && <section class="charity-related page-wrap" aria-labelledby="charity-related-title">
      <a class="charity-related-card" href="/community/wishope/">
        <div>
          <p class="eyebrow">Un altro modo per fare del bene</p>
          <h2 id="charity-related-title">WISHOPe</h2>
          <p>Il primo e-shop per fare un regalo a chi ne ha bisogno.</p>
          <span>Scopri WISHOPe <span aria-hidden="true">↗</span></span>
        </div>
        <AssetImage src="/assets/community/wishope.png" alt="WISHOPe, il progetto di regali solidali" loading="lazy" />
      </a>
    </section>}
    {page.slug === 'community/wishope' && <>
      <section class="wishope-how page-wrap" aria-labelledby="wishope-how-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Un gesto, tre momenti</p>
            <h2 id="wishope-how-title">Come funziona<br /><em>WISHOPe.</em></h2>
          </div>
          <p>Una piattaforma accessibile a tutti per raccontare un progetto, scegliere un regalo e lasciare una traccia concreta del bene fatto.</p>
        </div>
        <div class="wishope-step-grid">
          <article><AssetImage src="/assets/community/wishope-racconto.svg" alt="" /><span>01</span><h3>Racconto</h3><p>Una landing page e uno shop accessibili a tutti raccontano l’iniziativa.</p></article>
          <article><AssetImage src="/assets/community/wishope-esperienza.svg" alt="" /><span>02</span><h3>Esperienza</h3><p>Puoi personalizzare l’acquisto con un messaggio e scegliere la sede di destinazione.</p></article>
          <article><AssetImage src="/assets/community/wishope-ricordo.svg" alt="" /><span>03</span><h3>Ricordo</h3><p>Al termine dell’acquisto ricevi una mail di ringraziamento con un certificato.</p></article>
        </div>
      </section>
      <section class="wishope-story page-wrap" aria-labelledby="wishope-story-title">
        <div class="wishope-story-media"><AssetImage src="/assets/community/wishope-banner1.png" alt="Illustrazione della consegna di un regalo solidale" /></div>
        <div><p class="eyebrow">Un regalo che arriva davvero</p><h2 id="wishope-story-title">Donare un sorriso ai meno fortunati.</h2><p>Lo shop è accessibile a privati e aziende. I regali acquistati vengono consegnati insieme ai messaggi di dedica e la distribuzione è documentata con foto e video.</p></div>
      </section>
      <section class="wishope-participate page-wrap" aria-labelledby="wishope-participate-title">
        <div><p class="eyebrow">Una rete che partecipa</p><h2 id="wishope-participate-title">Ognuno può fare la sua parte.</h2><p>WISHOPe mette in relazione associazioni, produttori, distributori, aziende e persone.</p></div>
        <ul>
          <li><strong>Associazioni</strong><span>Racconta il progetto e coordina la distribuzione con la tua rete di volontari.</span></li>
          <li><strong>Produttori e distributori</strong><span>Sostieni l’iniziativa con un listino di prodotti a prezzi bloccati.</span></li>
          <li><strong>Privati e aziende</strong><span>Acquista, personalizza il messaggio e condividi l’iniziativa.</span></li>
        </ul>
      </section>
      <section class="wishope-projects page-wrap" aria-labelledby="wishope-current-title">
        <div class="section-heading"><div><p class="eyebrow">Progetto in corso</p><h2 id="wishope-current-title">Un aiuto concreto<br /><em>per i più piccoli.</em></h2></div><p>La pagina originale segnala come iniziativa attiva il progetto CRI4Kids della Croce Rossa di Milano.</p></div>
        <article class="wishope-project wishope-project--current"><AssetImage src="/assets/community/wishope-cri4kids.png" alt="Bambini e prodotti per l’infanzia per il progetto CRI4Kids" /><div><h3>WISHOPe per Croce Rossa di Milano</h3><p>Puoi regalare un kit di prodotti per l’infanzia a un bambino del progetto CRI4Kids, dedicato a famiglie fragili con bambini minori di due anni.</p><ul><li><strong>2500+</strong> prodotti essenziali necessari ogni mese</li><li><strong>60+</strong> famiglie in condizione di forte fragilità</li><li><strong>70+</strong> bambini di età inferiore a due anni</li></ul><a class="button" href="https://crocerossamilano.wishope.tinaba.it/">Scopri di più <span aria-hidden="true">↗</span></a></div></article>
      </section>
      <section class="wishope-archive page-wrap" aria-labelledby="wishope-archive-title">
        <div class="section-heading"><div><p class="eyebrow">Risultati</p><h2 id="wishope-archive-title">Progetti<br /><em>conclusi.</em></h2></div><p>Le iniziative restano documentate come archivio: non sono offerte attive, ma risultati verificabili del lavoro svolto con le associazioni partner.</p></div>
        <div class="wishope-archive-grid">
          <article><AssetImage src="/assets/community/wishope-natale-2025.png" alt="Banner WISHOPe Natale 2025" /><h3>WISHOPe Natale 2025</h3><p><strong>16.925 €</strong> raccolti · <strong>510</strong> sostenitori · <strong>677</strong> persone aiutate.</p><small>Iniziativa conclusa il 7 gennaio 2026.</small><a href="https://wishope.tinaba.it/">Guarda i risultati ↗</a></article>
          <article><AssetImage src="/assets/community/wishope-natale-2024.png" alt="Banner WISHOPe Natale 2024" /><h3>WISHOPe Natale 2024</h3><p><strong>19.875 €</strong> raccolti · <strong>576</strong> sostenitori · <strong>795</strong> persone aiutate.</p><small>Iniziativa conclusa il 9 gennaio 2025.</small><a href="https://wishope-2024.tinaba.it/">Guarda i risultati ↗</a></article>
          <article><AssetImage src="/assets/community/wishope-natale-2023.png" alt="Banner WISHOPe Natale 2023" /><h3>WISHOPe Natale 2023</h3><p><strong>46.825 €</strong> raccolti · <strong>1.429</strong> sostenitori · <strong>1.873</strong> persone aiutate.</p><small>Iniziativa conclusa il 9 gennaio 2024.</small><a href="https://wishope-2023.tinaba.it/">Guarda i risultati ↗</a></article>
        </div>
      </section>
      <section class="wishope-propose page-wrap" aria-labelledby="wishope-propose-title"><div><p class="eyebrow">Per organizzazioni e aziende</p><h2 id="wishope-propose-title">Crea la tua iniziativa WISHOPe.</h2><p>Il modulo presente sul sito originale richiede un endpoint e servizi di terze parti non inclusi nel sito statico. Per proporre un progetto, scrivi a Tinaba indicando organizzazione, città e canali di contatto.</p></div><a class="button" href="mailto:info@tinaba.it?subject=Proposta%20iniziativa%20WISHOPe">Contatta Tinaba <span aria-hidden="true">↗</span></a></section>
    </>}
    {page.slug === 'stampa' && <section class="press-archive page-wrap" aria-labelledby="press-archive-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Rassegna stampa</p>
          <h2 id="press-archive-title">Le storie che raccontano<br /><em>Tinaba e Banca Profilo.</em></h2>
        </div>
        <p>Una selezione dei comunicati e delle notizie pubblicate nell’area stampa originale. Le iniziative concluse sono archivio e non rappresentano offerte attive.</p>
      </div>
      <div class="press-grid">
        {pressItems.map((item) => <article class="press-card">
          <span class="press-date">{item.date}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a href={item.href}>Approfondisci <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </section>}
    {page.slug === 'promozioni' && <section class="promotion-index page-wrap" aria-labelledby="promotion-index-title">
      <div class="promotion-index-intro">
        <div>
          <p class="eyebrow">Iniziative e condizioni</p>
          <h2 id="promotion-index-title">Scegli cosa<br /><em>vuoi approfondire.</em></h2>
        </div>
        <p>Le iniziative hanno periodi, requisiti e regolamenti specifici. Qui trovi il percorso corretto per arrivare alla pagina dedicata o alla documentazione aggiornata.</p>
      </div>
      <div class="promotion-index-grid">
        <a class="promotion-index-card promotion-index-card--featured" href="/promozioni/scuola/">
          <AssetImage src="/assets/editorial/news-scuola-original.png" alt="Illustrazione della Promo Scuola Tinaba" loading="lazy" />
          <div><p class="promotion-index-label">In evidenza</p><h3>Promo Scuola</h3><p>Ottieni 30€ + 5% di Cashback sulle spese scolastiche, secondo requisiti e regolamento.</p><span>Scopri la promozione <span aria-hidden="true">↗</span></span></div>
        </a>
        <a class="promotion-index-card" href="/risparmio/conto-deposito/">
          <AssetImage src="/assets/editorial/news-conto-deposito-original.png" alt="Illustrazione del Conto Deposito di Banca Profilo" loading="lazy" />
          <div><p class="promotion-index-label">Prodotto collegato</p><h3>Conto Deposito</h3><p>Approfondisci il prodotto di Banca Profilo disponibile nell’App Tinaba e la documentazione da consultare.</p><span>Vai al Conto Deposito <span aria-hidden="true">↗</span></span></div>
        </a>
        <a class="promotion-index-card promotion-index-card--plain" href="/news/">
          <div><p class="promotion-index-label">Archivio</p><h3>News e iniziative</h3><p>Rileggi le novità, le partnership e le promozioni pubblicate, distinguendo le iniziative concluse da quelle da verificare.</p><span>Vedi tutte le novità <span aria-hidden="true">↗</span></span></div>
        </a>
      </div>
      <aside class="promotion-index-note">
        <strong>Prima di aderire</strong>
        <p>Controlla sempre periodo di validità, requisiti, costi, condizioni e regolamento applicabile. Le iniziative concluse restano nell’archivio e non rappresentano offerte attive.</p>
        <a href="/documenti/">Consulta i documenti <span aria-hidden="true">↗</span></a>
      </aside>
      <aside class="promotion-next-step" aria-labelledby="promotion-next-step-title">
        <div>
          <p class="eyebrow">Il passo successivo</p>
          <h2 id="promotion-next-step-title">Vuoi capire da dove partire?</h2>
          <p>Confronta Start, Premium e Under 18 per orientarti tra i piani disponibili.</p>
        </div>
        <a class="button" href="/piani/">Confronta i piani <span aria-hidden="true">↗</span></a>
      </aside>
    </section>}
    {page.slug !== 'community/charity' && page.slug !== 'promozioni' && page.slug !== 'piani' && <section class="page-wrap content-grid">
      <div class="summary scroll-reveal">
        {page.image && (
          <div
            class:list={['page-image-frame', { 'brand-logo-surface': page.slug === 'banca-profilo' }]}
          >
            <AssetImage class="page-image" src={page.image.src} alt={page.image.alt} loading="lazy" />
          </div>
        )}
        <p class="summary-label">In breve</p>
        <p>{page.summary}</p>
        {page.cta && (
          <div class="summary-actions">
            <p class="summary-label">Prossimo passo</p>
            <a class="button" href={page.cta.href}>{page.cta.label}</a>
          </div>
        )}
        {page.links && (
          <nav class="document-links" aria-label="Documenti e contatti">
            {page.links.map((link) => (
              <a href={link.href}>
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </nav>
        )}
        {productNotice && <aside class="product-note" aria-label="Informazioni importanti">
          <strong>{productNotice.title}</strong>
          <p>{productNotice.body}</p>
          <a href="/documenti/">Vai ai documenti <span aria-hidden="true">↗</span></a>
        </aside>}
      </div>
      <div class="sections">
        {page.sections.map((section) => (
          <article class="scroll-reveal">
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </article>
        ))}
      </div>
    </section>}
  </main>
  <SiteFooter />
</BaseLayout>

