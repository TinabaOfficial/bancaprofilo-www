---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AssetImage from '../components/AssetImage.astro';
import EditorialSpecialSections from '../components/editorial/EditorialSpecialSections.astro';
import EditorialContent from '../components/editorial/EditorialContent.astro';
import { getEditorialPage, type EditorialPage } from '../data/pages';
import { visualAssets } from '../data/editorial/visual-assets';
import { productNotices, productPagePrefixes } from '../data/editorial/product-content';
import { getEditorialSectionConfig } from '../data/editorial/section-registry';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  page: EditorialPage;
}
const { page } = Astro.props;
const commercePage = page.slug === 'business' ? getEditorialPage('business/e-commerce') : undefined;
const visual = page.image ?? visualAssets[page.slug];
const isProductPage = productPagePrefixes.some(
  (prefix) => page.slug === prefix || page.slug.startsWith(`${prefix}/`),
);
const productNotice = productNotices[page.slug] ?? (isProductPage ? {
  title: 'Informazioni sul servizio',
  body: 'Disponibilità, caratteristiche, costi e condizioni sono quelli indicati nella documentazione aggiornata di Banca Profilo.',
} : undefined);
const sectionConfig = getEditorialSectionConfig(page.slug);
---

<BaseLayout title={`${page.title} | Tinaba`} description={page.intro}>
  <SiteHeader />
  <main id="contenuto">
    <section class:list={['page-hero', { 'page-hero-visual': visual, 'page-hero-plans': page.slug === 'piani' }]}>
      <div class="page-wrap">
        <div class="hero-layout">
          <div>
            <Breadcrumbs slug={page.slug} tone="light" />
            <p class="eyebrow reveal" style="--reveal-delay: 100ms">{page.eyebrow}</p>
            <h1 class="reveal" style="--reveal-delay: 180ms">{page.title}</h1>
            <p class="intro reveal" style="--reveal-delay: 260ms">{page.intro}</p>
          </div>
          {visual && (
            <div
              class:list={['hero-visual reveal', { 'brand-logo-surface': page.slug === 'banca-profilo', 'plans-hero-visual': page.slug === 'piani' }]}
              style="--reveal-delay: 220ms"
            >
              <AssetImage src={visual.src} alt={visual.alt} loading="eager" fetchpriority="high" />
            </div>
          )}
        </div>
      </div>
    </section>
    <EditorialSpecialSections page={page} />
    {(!sectionConfig || sectionConfig.renderGenericContent) && <EditorialContent page={page} productNotice={productNotice} />}
    {commercePage && (
      <section class="business-commerce" aria-labelledby="business-commerce-title">
        <div class="page-wrap">
          <h2 id="business-commerce-title">{commercePage.title}</h2>
          <p>{commercePage.intro}</p>
        </div>
        <EditorialContent page={commercePage} productNotice={productNotices[commercePage.slug]} />
      </section>
    )}
  </main>
  <SiteFooter />
</BaseLayout>

<style is:global>@import "../styles/extracted/layouts_EditorialPageLayout.css";</style>
