---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AssetImage from '../components/AssetImage.astro';
import EditorialPlans from '../components/editorial/EditorialPlans.astro';
import EditorialAlipayPlus from '../components/editorial/EditorialAlipayPlus.astro';
import EditorialAssistance from '../components/editorial/EditorialAssistance.astro';
import EditorialWalletCommunity from '../components/editorial/EditorialWalletCommunity.astro';
import EditorialCharityWishope from '../components/editorial/EditorialCharityWishope.astro';
import EditorialPressPromotions from '../components/editorial/EditorialPressPromotions.astro';
import EditorialContent from '../components/editorial/EditorialContent.astro';
import type { EditorialPage } from '../data/pages';
import { visualAssets } from '../data/editorial/visual-assets';
import { productNotices, productPagePrefixes } from '../data/editorial/product-content';

interface Props {
  page: EditorialPage;
}
const { page } = Astro.props;
const visual = page.image ?? visualAssets[page.slug];
const isProductPage = productPagePrefixes.some(
  (prefix) => page.slug === prefix || page.slug.startsWith(`${prefix}/`),
);
const productNotice = productNotices[page.slug] ?? (isProductPage ? {
  title: 'Informazioni sul servizio',
  body: 'Disponibilità, caratteristiche, costi e condizioni sono quelli indicati nella documentazione aggiornata di Banca Profilo.',
} : undefined);
---

<BaseLayout title={`${page.title} | Tinaba`} description={page.intro}>
  <SiteHeader />
  <main id="contenuto">
    <section class:list={['page-hero', { 'page-hero-visual': visual, 'page-hero-plans': page.slug === 'piani' }]}>
      <div class="page-wrap">
        <div class="hero-layout">
          <div>
            <a class="back-link reveal" href="/">← Torna alla home</a>
            <p class="eyebrow reveal" style="--reveal-delay: 100ms">{page.eyebrow}</p>
            <h1 class="reveal" style="--reveal-delay: 180ms">{page.title}</h1>
            <p class="intro reveal" style="--reveal-delay: 260ms">{page.intro}</p>
          </div>
          {visual && (
            <div
              class:list={['hero-visual reveal', { 'brand-logo-surface': page.slug === 'banca-profilo', 'plans-hero-visual': page.slug === 'piani' }]}
              style="--reveal-delay: 220ms"
            >
              <AssetImage src={visual.src} alt={visual.alt} />
            </div>
          )}
        </div>
      </div>
    </section>
    {page.slug === 'piani' && <EditorialPlans />}
    {page.slug === 'pagamenti/alipay-plus' && <EditorialAlipayPlus />}
    {page.slug === 'assistenza' && <EditorialAssistance />}
    {(page.slug === 'wallet' || page.slug === 'community') && <EditorialWalletCommunity />}
    {(page.slug === 'community/charity' || page.slug === 'community/wishope') && <EditorialCharityWishope page={page} />}
    {(page.slug === 'stampa' || page.slug === 'promozioni') && <EditorialPressPromotions page={page} />}
    {page.slug !== 'community/charity' && page.slug !== 'community/wishope' && page.slug !== 'promozioni' && page.slug !== 'piani' && page.slug !== 'stampa' && <EditorialContent page={page} productNotice={productNotice} />}
  </main>
  <SiteFooter />
</BaseLayout>

<style is:global>@import "../styles/extracted/layouts_EditorialPageLayout.css";</style>
